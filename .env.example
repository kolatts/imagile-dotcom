# Azure Application Insights connection string (optional — analytics no-ops if unset)
PUBLIC_APPINSIGHTS_CONNECTION_STRING=

# Cloudflare Turnstile site key (public by design). Defaults to the real
# production site key in ContactForm.astro if unset, so this is only
# needed to override for local testing against Cloudflare's always-pass
# test key: 1x00000000000000000000AA
PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAED2hq95425ROypd

# Base URL of the imagile-app API the contact form posts to
PUBLIC_INTAKE_API_URL=https://api.imagile.dev

# LinkedIn Insight Tag Partner ID (public by design). Defaults to the real
# production ID in LinkedInInsightTag.astro if unset; set to "off" to disable
# the tag locally so your own visits don't land in retargeting audiences.
PUBLIC_LINKEDIN_PARTNER_ID=off
