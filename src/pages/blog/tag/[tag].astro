---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import PostCard from '../../../components/PostCard.astro';
import { readingTime } from '../../../lib/reading-time';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  const tags = [...new Set(allPosts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: {
      posts: allPosts
        .filter((p) => p.data.tags.includes(tag))
        .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()),
    },
  }));
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<Layout title={`Tag: ${tag}`} description={`Posts tagged "${tag}" on the Imagile blog.`}>
  <SiteHeader />
  <main>
    <section class="section section--tight">
      <div class="container">
        <p class="eyebrow">Tag</p>
        <h1 class="blog-index__title">{tag}</h1>
        <a href="/blog" class="btn btn--ghost btn--sm">← All posts</a>
      </div>
    </section>

    <section class="section section--tight">
      <div class="container blog-index__grid">
        {posts.map((post) => (
          <PostCard
            title={post.data.title}
            description={post.data.description}
            publishDate={post.data.publishDate}
            tags={post.data.tags}
            slug={post.id}
            readingTime={readingTime(post.body ?? '')}
          />
        ))}
      </div>
    </section>
  </main>
  <SiteFooter />
</Layout>

<style>
  .blog-index__title { font-size: var(--text-3xl); margin: 0.5rem 0 1.1rem; }
  .blog-index__grid { display: grid; grid-template-columns: 1fr; gap: var(--space-md); margin-top: var(--space-md); }
  @media (min-width: 640px) { .blog-index__grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 980px) { .blog-index__grid { grid-template-columns: 1fr 1fr 1fr; } }
</style>
