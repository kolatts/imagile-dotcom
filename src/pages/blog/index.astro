---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import PostCard from '../../components/PostCard.astro';
import { readingTime } from '../../lib/reading-time';

const POSTS_PER_PAGE = 12;

const allPosts = (await getCollection('blog')).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);
const pagePosts = allPosts.slice(0, POSTS_PER_PAGE);
const totalPages = Math.ceil(allPosts.length / POSTS_PER_PAGE);
const allTags = [...new Set(allPosts.flatMap((p) => p.data.tags))].sort();
---

<Layout
  title="Blog"
  description="Notes on AI-assisted development, agentic workflows, and building software that ships — from Sunny Kolattukudy."
>
  <SiteHeader />
  <main>
    <section class="section section--tight">
      <div class="container blog-index__head">
        <p class="eyebrow">Writing</p>
        <h1 class="blog-index__title">The blog</h1>
        <p class="blog-index__sub">
          Notes on AI-assisted development, agentic workflows, and building software that ships.
          No thought leadership — see <a href="/blog/welcome-to-imagile-blog">why</a>.
        </p>
        {allTags.length > 0 && (
          <div class="blog-index__tags">
            {allTags.map((tag) => (
              <a href={`/blog/tag/${tag}`} class="tag-pill">{tag}</a>
            ))}
          </div>
        )}
      </div>
    </section>

    <section class="section section--tight">
      <div class="container blog-index__grid">
        {pagePosts.map((post) => (
          <PostCard
            title={post.data.title}
            description={post.data.description}
            publishDate={post.data.publishDate}
            tags={post.data.tags}
            slug={post.id}
            readingTime={readingTime(post.body ?? '')}
          />
        ))}
      </div>

      {totalPages > 1 && (
        <div class="container blog-index__pagination">
          <a href="/blog/page/2" class="btn btn--ghost btn--sm">Older posts →</a>
        </div>
      )}
    </section>
  </main>
  <SiteFooter />
</Layout>

<style>
  .blog-index__head { max-width: 60ch; }
  .blog-index__title { font-size: var(--text-3xl); margin: 0.5rem 0 0.8rem; }
  .blog-index__sub { color: var(--color-muted); font-size: var(--text-lg); }
  .blog-index__sub a { color: var(--color-accent); text-decoration: underline; }

  .blog-index__tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: var(--space-md); }

  .blog-index__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
  }

  .blog-index__pagination { margin-top: var(--space-lg); }

  @media (min-width: 640px) { .blog-index__grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 980px) { .blog-index__grid { grid-template-columns: 1fr 1fr 1fr; } }
</style>
