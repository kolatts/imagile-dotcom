---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BlogPostCard from '../../components/blog/BlogPostCard.astro';
import Pagination from '../../components/blog/Pagination.astro';
import { BLOG_PAGE_SIZE } from '../../lib/paths';

const allPosts = (await getCollection('blog', (entry) => !entry.data.draft)).sort(
  (a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime()
);

const totalPages = Math.max(1, Math.ceil(allPosts.length / BLOG_PAGE_SIZE));
const posts = allPosts.slice(0, BLOG_PAGE_SIZE);
---

<Layout
  title="Blog - Imagile"
  description="AI training, .NET and Azure delivery, and startup technology coaching -- written by the people doing the work."
>
  <Header />
  <main>
    <section class="blog-header">
      <div class="container">
        <h1 class="blog-title">Blog</h1>
        <p class="blog-subtitle">
          AI training, .NET and Azure delivery, and startup technology coaching -- written by the people doing the work.
        </p>
      </div>
    </section>

    <section class="container">
      {posts.length > 0 ? (
        <div class="blog-grid">
          {posts.map(post => (
            <BlogPostCard
              title={post.data.title}
              description={post.data.description}
              publishDate={post.data.publishDate}
              author={post.data.author}
              tags={post.data.tags}
              id={post.id}
              image={post.data.image}
            />
          ))}
        </div>
      ) : (
        <div style="text-align: center; padding: var(--space-xl) 0;">
          <p style="color: var(--color-text-secondary); font-size: 1.25rem;">
            No blog posts yet -- check back soon.
          </p>
        </div>
      )}

      <Pagination currentPage={1} totalPages={totalPages} />
    </section>
  </main>
  <Footer />
</Layout>

<style>
  @import '../../styles/blog.css';
</style>
