---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import PostCard from '../../../components/PostCard.astro';
import { readingTime } from '../../../lib/reading-time';

export async function getStaticPaths({ paginate }) {
  const allPosts = (await getCollection('blog')).sort(
    (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
  );
  // Page 1 is served by /blog itself; this route starts at page 2.
  return paginate(allPosts, { pageSize: 12 }).slice(1);
}

const { page } = Astro.props;
---

<Layout title={`Blog — page ${page.currentPage}`} description="Older posts from the Imagile blog.">
  <SiteHeader />
  <main>
    <section class="section section--tight">
      <div class="container">
        <p class="eyebrow">Writing</p>
        <h1 class="blog-index__title">Blog — page {page.currentPage}</h1>
      </div>
    </section>

    <section class="section section--tight">
      <div class="container blog-index__grid">
        {page.data.map((post) => (
          <PostCard
            title={post.data.title}
            description={post.data.description}
            publishDate={post.data.publishDate}
            tags={post.data.tags}
            slug={post.id}
            readingTime={readingTime(post.body ?? '')}
          />
        ))}
      </div>

      <div class="container blog-index__pagination">
        {page.url.prev && <a href={page.url.prev} class="btn btn--ghost btn--sm">← Newer</a>}
        {page.url.next && <a href={page.url.next} class="btn btn--ghost btn--sm">Older →</a>}
      </div>
    </section>
  </main>
  <SiteFooter />
</Layout>

<style>
  .blog-index__title { font-size: var(--text-3xl); margin: 0.5rem 0 0.8rem; }
  .blog-index__grid { display: grid; grid-template-columns: 1fr; gap: var(--space-md); }
  .blog-index__pagination { margin-top: var(--space-lg); display: flex; gap: 0.75rem; }
  @media (min-width: 640px) { .blog-index__grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 980px) { .blog-index__grid { grid-template-columns: 1fr 1fr 1fr; } }
</style>
