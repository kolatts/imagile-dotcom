---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import Hero from '../../components/Hero.astro';
import Prose from '../../components/Prose.astro';
import PostCard from '../../components/PostCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { readingTime } from '../../lib/reading-time';

const RELEVANT_TAGS = ['azure', 'dotnet', 'architecture', 'cloud', 'software-engineering'];

const pricing = [
  { row: 'Advisory / hands-on hourly', price: '$300/hr' },
  { row: 'Day engagements, remote or on-site', price: 'Quoted up front' },
  { row: 'Production build with integrations', price: 'Scoped after discovery' },
  { row: 'Ongoing retainer', price: 'Scoped to your cadence' },
];

const related = (await getCollection('blog'))
  .filter((p) => p.data.tags.some((t) => RELEVANT_TAGS.includes(t)))
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 3);
---

<Layout title="Custom Software" description="You know your industry. I turn that knowledge into working software — scoped, built, and launched by one senior engineer, explained in plain English the whole way.">
  <SiteHeader />
  <main>
    <Hero
      eyebrow="Service 03"
      title="You know the industry. <em>I build the software.</em>"
      subtitle="You've spent years inside a business and can see the product it's missing. I turn that into working software — scoped, built, and launched by one senior engineer, explained in plain English the whole way."
      primaryCta={{ href: '/contact', label: 'Get in touch' }}
      secondaryCta={{ href: '/work', label: 'See the work' }}
      size="md"
      markImage="/images/services/custom-software.webp"
    />

    <section class="section section--tight who">
      <div class="container">
        <p class="eyebrow">Who this is for</p>
        <h2 class="who__title">People who know exactly what should exist — and need someone to build it</h2>
        <Prose>
          <p>
            Most often that's a domain expert with a startup idea. You've spent a career in insurance, logistics,
            healthcare, construction — some industry where you can see the product everyone needs and nobody has
            built. You don't need to learn to code, and you don't need to gamble on a technical co-founder on day
            one. You need a first version real customers can use, built by someone who's shipped software for
            twenty years and can explain every decision without the jargon.
          </p>
          <p>
            It's also for established businesses past the strategy conversation — an internal tool nobody else
            will prioritize, an integration between systems that don't want to talk to each other, a
            customer-facing product that has to hold up under real load. If the deliverable is working software,
            this is the service.
          </p>
          <p>
            It's not for teams that want a headcount-shaped hire, or a body to sit in standups indefinitely.
            One senior engineer, scoped work, a defined handoff — that's the shape.
          </p>
        </Prose>
      </div>
    </section>

    <section class="section section--tight what-happens grid-ground">
      <div class="container">
        <p class="eyebrow">What happens</p>
        <h2 class="what-happens__title">Scope it, build it, ship it — same person the whole way</h2>
        <Prose>
          <p>
            Every build starts with the scope: what it needs to do, who uses it, and what "done" actually
            means — written down in plain English before any code gets written. The big decisions get made up
            front and explained, not discovered three months in. Then it gets built, with the ability to ship
            updates continuously from day one, so version two costs a fraction of version one.
          </p>
          <p>
            Under the hood it's the same enterprise-grade technology large companies run on (.NET, Azure, AWS) —
            but you don't have to care about any of that. What you have to know is that it launches, holds up,
            and can grow with you.
          </p>
          <p>
            This isn't theoretical. <a href="/work">Imagile-app and Context Overflow are public</a> — you, or any
            engineer you trust, can read the code and judge the work directly instead of taking my word for it.
            That's the standard the software you're paying for is held to as well.
          </p>
          <p>
            If your product needs AI inside it, I bring in the industry standards from OpenAI and Anthropic —
            the technology behind ChatGPT and Claude — and pick the setup that fits your costs, your customers,
            and your compliance requirements.
          </p>
        </Prose>
      </div>
    </section>

    <section class="section section--tight walk-away">
      <div class="container">
        <p class="eyebrow">What you walk away with</p>
        <h2 class="walk-away__title">Production software, not a prototype</h2>
        <div class="walk-away__grid">
          <div class="card" data-reveal>
            <span class="card-tag">DELIVERABLE</span>
            <h3>Working, deployed software</h3>
            <p>Running in your environment, under your control — not a demo folder or a Figma file.</p>
          </div>
          <div class="card" data-reveal>
            <span class="card-tag">DELIVERABLE</span>
            <h3>A way to keep shipping</h3>
            <p>The next improvement releases as easily as the first — no rebuild, no starting over.</p>
          </div>
          <div class="card" data-reveal>
            <span class="card-tag">DELIVERABLE</span>
            <h3>Documentation your next hire can run with</h3>
            <p>Every decision and how-it-works written down in plain language, not left in one person's head.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section section--tight pricing grid-ground">
      <div class="container">
        <p class="eyebrow">How pricing works</p>
        <h2 class="pricing__title">Real numbers, not a "contact us" form</h2>
        <div class="pricing__table-wrap">
          <table class="pricing__table">
            <thead>
              <tr><th>Engagement</th><th>Price</th></tr>
            </thead>
            <tbody>
              {pricing.map((p) => (
                <tr>
                  <td>{p.row}</td>
                  <td>{p.price}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="pricing__note">
          Most engagements start with a short AI transformation strategy session — a focused conversation and a
          written recommendation, credited toward whatever comes next. Remote work is priced the same as the work;
          on-site carries a day-rate premium plus travel at cost, never a surprise change order. These are
          real numbers, not a "contact us" form.
        </p>
      </div>
    </section>

    {related.length > 0 && (
      <section class="section section--tight reading">
        <div class="container">
          <p class="eyebrow">Related reading</p>
          <h2 class="reading__title">From the blog</h2>
          <div class="reading__grid">
            {related.map((post) => (
              <PostCard
                title={post.data.title}
                description={post.data.description}
                publishDate={post.data.publishDate}
                tags={post.data.tags}
                slug={post.id}
                readingTime={readingTime(post.body ?? '')}
              />
            ))}
          </div>
        </div>
      </section>
    )}

    <CtaBand title="Scope the build before you commit to it." />
  </main>
  <SiteFooter />
</Layout>

<style>
  .who__title { font-size: var(--text-2xl); margin: 0.5rem 0 var(--space-md); max-width: 36ch; }
  .what-happens__title { font-size: var(--text-2xl); margin: 0.5rem 0 var(--space-md); max-width: 40ch; }

  .walk-away__title { font-size: var(--text-2xl); margin: 0.5rem 0 var(--space-md); }
  .walk-away__grid { display: grid; grid-template-columns: 1fr; gap: var(--space-sm); }
  .walk-away__grid h3 { font-size: var(--text-lg); margin-bottom: 0.5rem; }
  .walk-away__grid p { color: var(--color-muted); }

  .pricing__title { font-size: var(--text-2xl); margin: 0.5rem 0 var(--space-md); }
  .pricing__table-wrap { overflow-x: auto; border: 1px solid var(--color-line); background: var(--color-surface); }
  .pricing__table { width: 100%; border-collapse: collapse; font-size: var(--text-base); }
  .pricing__table th, .pricing__table td { padding: 0.85rem 1rem; text-align: left; border-bottom: 1px solid var(--color-line); }
  .pricing__table th {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .pricing__table tbody tr:last-child td { border-bottom: none; }
  .pricing__table td:last-child { font-family: var(--font-mono); font-size: var(--text-sm); white-space: nowrap; }
  .pricing__note { color: var(--color-muted); max-width: var(--measure); margin-top: var(--space-md); }

  .reading__title { font-size: var(--text-2xl); margin: 0.5rem 0 var(--space-md); }
  .reading__grid { display: grid; grid-template-columns: 1fr; gap: var(--space-md); }

  @media (min-width: 720px) {
    .walk-away__grid { grid-template-columns: repeat(3, 1fr); }
  }

  @media (min-width: 640px) {
    .reading__grid { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 980px) {
    .reading__grid { grid-template-columns: 1fr 1fr 1fr; }
  }
</style>
