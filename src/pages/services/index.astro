---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import Hero from '../../components/Hero.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import CtaBand from '../../components/CtaBand.astro';

const services = [
  {
    title: 'AI Developer Training',
    body: "Your engineers, fluent in agentic development — judgment and workflow, not tool tutorials. On-site in Central Ohio or remote to a distributed team, equally first-class.",
    href: '/services/developer-training',
    priceSignal: 'Half-day, full-day, or 4-week cohort',
  },
  {
    title: 'Automate Your Business Processes',
    body: 'The repetitive work your team does by hand — intake, triage, reporting, follow-ups — handed to AI from OpenAI and Anthropic, and proven trustworthy before it takes over.',
    href: '/services/agentic-workflows',
    priceSignal: 'Scoped after a free 15-minute consultation',
  },
  {
    title: 'Custom Software Development',
    body: 'From idea to launched product — designed, built, and shipped by one senior engineer, explained in plain English the whole way.',
    href: '/services/custom-software',
    priceSignal: 'Hourly advisory · Builds scoped after discovery',
  },
  {
    title: 'Technical Advisory & Fractional CTO',
    body: 'Senior technical judgment on retainer — architecture reviews, AI strategy, vendor and hiring calls — without the full-time hire.',
    href: '/contact',
    priceSignal: 'Monthly retainer · scoped to your cadence',
  },
];
---

<Layout title="Services" description="Three ways to work with Imagile: developer training, agentic workflow building, and custom software — all senior-led, no handoffs.">
  <SiteHeader />
  <main>
    <Hero
      eyebrow="What Imagile does"
      title="Train the team, build the workflow, ship the <em>software.</em>"
      subtitle="Four ways to work together, one person doing all of them — pick the one that matches where you're stuck."
      size="md"
    />

    <section class="section services">
      <div class="container">
        <div class="services__grid">
          {services.map((s) => <ServiceCard {...s} />)}
        </div>
      </div>
    </section>

    <CtaBand
      title="Not sure which one you need?"
      body="Tell me what's going on and I'll point you at the right one — or tell you it's not a fit."
    />
  </main>
  <SiteFooter />
</Layout>

<style>
  .services__grid { display: grid; grid-template-columns: 1fr; gap: var(--space-sm); }

  @media (min-width: 720px) {
    .services__grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>
