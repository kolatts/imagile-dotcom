---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Hero from '../components/Hero.astro';
import ProofItem from '../components/ProofItem.astro';
import BuildCard from '../components/BuildCard.astro';
import Prose from '../components/Prose.astro';
import CtaBand from '../components/CtaBand.astro';

const highlights = [
  {
    area: 'AI engineering, in production',
    bullets: [
      'Built automated fix workflows that detect and triage bugs and propose code fixes automatically — wired into Datadog, Sentry, and App Insights — now covering 30% of fixes.',
      'Built an AI-powered code review pipeline with automatic fallback across model providers — cut review time by 30+ minutes per pull request, and it keeps working through provider outages.',
      'Shipped an AI ops pipeline that triages production alerts and hands engineers the fix with the investigation behind it — screenshots included — before anyone asks.',
      'Architected an AI-native internal developer portal with agent skills, self-healing workflows, and end-to-end test history, so engineers and coding agents work against a fully realistic environment.',
    ],
  },
  {
    area: 'Platforms and rewrites',
    bullets: [
      'Set the technical vision for a company-wide product platform designed to scale 10x, with a live sync bridge to the legacy applications it replaced.',
      'Rewrote a failing event-driven architecture — 98% performance improvement and an end to customer data loss.',
      'Led rewrites of institutional finance systems handling millions of dollars per hour — 86%+ faster, passing internal audit.',
      'Quadrupled deployment frequency by rebuilding CI/CD from the ground up.',
    ],
  },
];

const otherBuilds = [
  {
    index: 'BUILD-04',
    title: 'imagile-app',
    body: 'The multi-tenant B2B SaaS platform behind Imagile itself: .NET, Blazor WASM, Azure Container Apps.',
  },
  {
    index: 'BUILD-05',
    title: "This site's blog pipeline",
    body: 'A GitHub Actions workflow where a Claude Code agent drafts posts from filed issues, opens a PR, and iterates on review feedback.',
    href: '/blog',
    linkLabel: 'Read the posts →',
  },
];
---

<Layout title="Work" description="Over a decade of shipped engineering outcomes — AI pipelines, platform rewrites, measurable results — plus Imagile's own public builds you can inspect today.">
  <SiteHeader />
  <main>
    <Hero
      eyebrow="Proof"
      title="Over a decade of shipped work. The <em>recent stuff is public.</em>"
      subtitle="Outcomes from staff and principal engineering roles across banking, HR tech, health tech, and ed tech — plus the builds shipped under the Imagile name, live and open for inspection right now."
      size="md"
      primaryCta={{ href: '/contact', label: 'Get in touch' }}
      secondaryCta={{ href: '#builds', label: 'See the public builds' }}
    />

    <section class="section section--tight intro">
      <div class="container">
        <Prose>
          <p>
            Two kinds of evidence here. First, builds released under the Imagile name — live, open, and
            yours to click through and judge firsthand. Second, outcomes from over a decade in staff and
            principal roles, described without naming employers or clients, deliberately. Discretion is
            part of the service, and the work you'd hire Imagile for gets the same treatment.
          </p>
        </Prose>
      </div>
    </section>

    <section id="builds" class="section section--tight builds grid-ground">
      <div class="container">
        <p class="eyebrow">Public builds</p>
        <h2 class="role-section__title">Built under the Imagile name</h2>
        <p class="role-section__note">
          Shipped and maintained in the open. Don't take my word for any of it — every screenshot below
          opens the real thing.
        </p>

        <div class="builds__features">
          <BuildCard
            layout="wide"
            tag="BUILD-01 · Open source · Beta"
            title="toil"
            address="imagile-dev.github.io/toil"
            image={{ src: '/images/work/toil-cli.webp', alt: 'The toil home page: a diagram with AI agents, people and CI/CD on the left, one toil command in the middle, and the tools it reaches on the right, including Jira, GitHub, Jenkins and databases.', width: 1262, height: 770 }}
            links={[
              { href: 'https://imagile-dev.github.io/toil', label: 'See toil ↗' },
              { href: 'https://github.com/imagile-dev/toil', label: 'Source on GitHub ↗' },
            ]}
          >
            <p>
              The token-efficient alternative to MCP: one CLI between whoever asks — an AI agent, a person,
              a pipeline — and your enterprise tools and databases. One command in, one JSON answer back.
            </p>
            <p>
              It reaches 32 tools so far, from Jira and Azure DevOps to GitHub, Jenkins, SQL databases and
              Dynatrace.
            </p>
          </BuildCard>

          <BuildCard
            layout="wide"
            flip
            tag="BUILD-02 · Live demo on sample data"
            title="Toil UI"
            address="imagile-dev.github.io/toil/ui"
            image={{ src: '/images/work/toil-ui-board.webp', alt: 'Toil UI showing a sample card-payments project: a sprint board with To do, In progress and Done columns, each story flagged with what needs attention.', width: 1262, height: 700 }}
            links={[
              { href: 'https://imagile-dev.github.io/toil/ui/', label: 'Take it for a spin ↗' },
            ]}
          >
            <p>
              Your projects on one screen: the sprint, the board, pull requests, builds and deployments — and
              a chat that cites every item it reads. It opens with a one-sentence briefing on where the
              sprint stands and why.
            </p>
            <p>
              Runs on your own machine through toil, with your own connections, and changes nothing unless
              you ask. The demo is the real app on sample data.
            </p>
          </BuildCard>

          <BuildCard
            layout="wide"
            tag="BUILD-03 · Free to read, no account"
            title="Context Overflow"
            address="context-overflow.dev"
            image={{ src: '/images/work/context-overflow.webp', alt: 'The Context Overflow home page: the headline Learn AI before your org chart does, beside an illustration of a crowd of cartoon robots throwing paperwork.', width: 1126, height: 770 }}
            links={[
              { href: 'https://context-overflow.dev', label: 'Open Context Overflow ↗' },
              { href: 'https://context-overflow.dev/modules', label: 'Browse the modules ↗' },
            ]}
          >
            <p>
              A gamified AI-fluency platform, taught by a cast of deadpan corporate robots. Behind the jokes
              it's a real curriculum on how these models work — plus an arcade and a public model-comparison lab.
            </p>
            <p>
              React 19 SPA on a .NET 9 Azure Functions API. Enroll with org code <code>IMAGILE</code> for
              the Imagile track.
            </p>
          </BuildCard>
        </div>

        <div class="builds__grid">
          {otherBuilds.map((build) => (
            <div class="card builds__card" data-reveal>
              <span class="card-tag">{build.index}</span>
              <h3 class="builds__title">{build.title}</h3>
              <p class="builds__body">{build.body}</p>
              {build.href && (
                <a href={build.href} class="builds__link">{build.linkLabel}</a>
              )}
            </div>
          ))}
        </div>

        <div class="builds__ask" data-reveal>
          <p>Want something like this built for your team — or your team taught to build it?</p>
          <a href="/contact" class="btn btn--primary">Get in touch</a>
        </div>
      </div>
    </section>

    <section class="section section--tight stats">
      <div class="container">
        <p class="eyebrow">The headline numbers</p>
        <div class="stats__grid">
          <ProofItem stat="30%" label="of bugs detected, triaged, and fixed by automated fix workflows" source="Datadog · Sentry · App Insights" />
          <ProofItem stat="30+ min" label="cut from PR review time, per pull request" source="AI code review pipeline" />
          <ProofItem stat="98%" label="performance improvement on a rewritten event-driven system" source="Event-architecture rewrite" />
          <ProofItem stat="4x" label="improvement in deployment frequency" source="CI/CD rebuild" />
          <ProofItem stat="86%+" label="performance improvement on institutional finance workloads" source="Legacy system rewrite" />
          <ProofItem stat="Hours/wk" label="of engineering time returned by agentic workflows and self-healing systems" source="Developer experience work" />
        </div>
      </div>
    </section>

    <section class="section role-section" data-reveal>
      <div class="container">
        <p class="eyebrow">The track record</p>
        <h2 class="role-section__title">Where the numbers come from</h2>
        <p class="role-section__note">
          Selected outcomes from over a decade of staff- and principal-level work. No names, no dates —
          just what shipped and what it changed.
        </p>

        <div class="role-block__group">
          {highlights.map((h) => (
            <div class="role-block">
              <div class="role-block__header">
                <h3>{h.area}</h3>
              </div>
              <ul class="role-block__list">
                {h.bullets.map((b) => <li>{b}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <CtaBand title="That's the proof. Want to talk about the work?" />
  </main>
  <SiteFooter />
</Layout>

<style>
  .intro :global(.prose-content) { color: var(--color-muted); }

  .stats__grid { display: grid; grid-template-columns: 1fr; gap: var(--space-md); }

  .role-section__title { font-size: var(--text-2xl); margin: 0.5rem 0 0.6rem; max-width: 36ch; }
  .role-section__note { color: var(--color-muted); max-width: 58ch; margin-bottom: var(--space-lg); }

  .role-block__group { display: grid; grid-template-columns: 1fr; gap: var(--space-xl); }

  .role-block__header { margin-bottom: var(--space-sm); }
  .role-block__header h3 { font-size: var(--text-xl); }

  .role-block__list { display: grid; gap: var(--space-sm); }
  .role-block__list li {
    color: var(--color-muted);
    border-top: 1px solid var(--color-line);
    padding-top: var(--space-sm);
    max-width: var(--measure);
  }

  .builds { scroll-margin-top: 64px; }
  .builds__features { display: grid; gap: var(--space-xl); margin-top: var(--space-lg); }
  .builds__grid { display: grid; grid-template-columns: 1fr; gap: var(--space-md); margin-top: var(--space-xl); }
  .builds__ask {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-line);
  }
  .builds__ask p { font-family: var(--font-display); font-size: var(--text-xl); max-width: 34ch; }

  .builds__card { display: flex; flex-direction: column; gap: 0.6rem; }
  .builds__title { font-size: var(--text-lg); }
  .builds__body { color: var(--color-muted); }
  .builds__link {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-accent);
    text-decoration: underline;
    margin-top: auto;
    padding-top: 0.4rem;
  }

  @media (min-width: 640px) {
    .stats__grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 760px) {
    .builds__ask { flex-direction: row; align-items: center; justify-content: space-between; }
  }

  @media (min-width: 720px) {
    .role-block__group { grid-template-columns: repeat(2, 1fr); }
    .builds__grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 980px) {
    .stats__grid { grid-template-columns: repeat(3, 1fr); }
  }
</style>
