---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Hero from '../components/Hero.astro';
import PathPicker from '../components/PathPicker.astro';
import ServiceCard from '../components/ServiceCard.astro';
import PostCard from '../components/PostCard.astro';
import BuildCard from '../components/BuildCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { readingTime } from '../lib/reading-time';

const services = [
  {
    title: 'AI Developer Training',
    body: "Your engineers, fluent in agentic development — judgment and workflow, not tool tutorials. On-site in Central Ohio or remote to a distributed team, equally first-class.",
    href: '/services/developer-training',
    priceSignal: 'Half-day, full-day, or 4-week cohort',
  },
  {
    title: 'Automate Your Business Processes',
    body: 'The repetitive work your team does by hand — intake, triage, reporting, follow-ups — handed to AI from OpenAI and Anthropic, and proven trustworthy before it takes over.',
    href: '/services/agentic-workflows',
    priceSignal: 'Scoped after a free 15-minute consultation',
  },
  {
    title: 'Custom Software Development',
    body: 'From idea to launched product — designed, built, and shipped by one senior engineer, explained in plain English the whole way.',
    href: '/services/custom-software',
    priceSignal: 'Hourly advisory · Builds scoped after discovery',
  },
  {
    title: 'Technical Advisory & Fractional CTO',
    body: 'Senior technical judgment on retainer — architecture reviews, AI strategy, vendor and hiring calls — without the full-time hire.',
    href: '/contact',
    priceSignal: 'Monthly retainer · scoped to your cadence',
  },
];

const latestPosts = (await getCollection('blog'))
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 3);
---

<Layout title="Imagile">
  <SiteHeader />
  <main>
    <Hero
      eyebrow="AI consulting · Columbus, Ohio"
      title="AI that actually <em>works.</em>"
      subtitle="Training for your team, automation that does real work, and custom software — all of it from the person who does the work, not a bench you never meet."
      primaryCta={{ href: '/contact', label: 'Get in touch' }}
      secondaryCta={{ href: '/work', label: 'See the work' }}
    />

    <PathPicker />

    <section class="section section--tight open-work grid-ground">
      <div class="container">
        <p class="eyebrow">Built in the open</p>
        <h2 class="open-work__title">Don't take the pitch on faith. Open the work.</h2>
        <p class="open-work__note">
          Two things Imagile ships and keeps running in public. Both are live right now — click through
          and judge for yourself.
        </p>

        <div class="open-work__grid">
          <BuildCard
            tag="Free and open · In beta"
            title="toil"
            address="imagile-dev.github.io/toil/ui"
            image={{ src: '/images/work/toil-ui-briefing.webp', alt: 'Toil UI on a sample project. The briefing reads: Behind, 18 of 21 points are left and 3 working days remain, followed by three cards on what needs attention.', width: 912, height: 624 }}
            links={[
              { href: 'https://imagile-dev.github.io/toil/ui/', label: 'Try the live demo ↗' },
              { href: 'https://imagile-dev.github.io/toil/', label: 'See how toil works ↗' },
            ]}
          >
            <p>
              Ask where a project really stands and get a straight answer — progress, what's stuck, and what
              ships next, on one screen. That screen is Toil UI. Underneath it, toil connects AI — and the
              people working beside it — to the tools your team already uses.
            </p>
          </BuildCard>

          <BuildCard
            tag="Free, self-serve"
            title="Context Overflow"
            address="context-overflow.dev"
            image={{ src: '/images/work/context-overflow.webp', alt: 'The Context Overflow home page: the headline Learn AI before your org chart does, beside an illustration of a crowd of cartoon robots throwing paperwork.', width: 1126, height: 770 }}
            links={[
              { href: 'https://context-overflow.dev', label: 'Start understanding AI ↗' },
            ]}
          >
            <p>
              New to AI at work? Start there, not here. A free, self-paced course on how these tools actually
              work — no sales call required. Enroll with org code <code>IMAGILE</code> for the Imagile track.
            </p>
          </BuildCard>
        </div>

        <div class="open-work__ask" data-reveal>
          <p>Want this kind of work pointed at your problem?</p>
          <div class="open-work__actions">
            <a href="/contact" class="btn btn--primary">Get in touch</a>
            <a href="/work" class="btn btn--ghost">See all the work →</a>
          </div>
        </div>
      </div>
    </section>

    <section class="section services">
      <div class="container">
        <p class="eyebrow">What Imagile does</p>
        <h2 class="services__title">Four ways in</h2>
        <div class="services__grid">
          {services.map((s) => <ServiceCard {...s} />)}
        </div>
      </div>
    </section>

    <section class="section section--tight method">
      <div class="container">
        <p class="eyebrow">How an engagement starts</p>
        <h2 class="method__title">Three steps, not a sales funnel</h2>
        <ol class="method__list">
          <li data-reveal>
            <span class="method__num">01</span>
            <div>
              <h3>AI transformation strategy</h3>
              <p>A short, focused session to figure out what's actually worth doing — and a written recommendation you keep either way.</p>
            </div>
          </li>
          <li data-reveal>
            <span class="method__num">02</span>
            <div>
              <h3>Discovery sprint</h3>
              <p>Two weeks, remote-first, fixed fee. You get a scoped plan before any open-ended engagement begins.</p>
            </div>
          </li>
          <li data-reveal>
            <span class="method__num">03</span>
            <div>
              <h3>Build, train, or retain</h3>
              <p>Implementation, a training cohort, or an ongoing retainer — whichever the sprint says you actually need.</p>
            </div>
          </li>
        </ol>
        <div class="method__ask" data-reveal>
          <p>Step one starts with a short conversation.</p>
          <a href="/contact" class="btn btn--primary">Get in touch</a>
        </div>
      </div>
    </section>

    {latestPosts.length > 0 && (
      <section class="section section--tight writing">
        <div class="container">
          <p class="eyebrow">Latest writing</p>
          <h2 class="writing__title">From the blog</h2>
          <div class="writing__grid">
            {latestPosts.map((post) => (
              <PostCard
                title={post.data.title}
                description={post.data.description}
                publishDate={post.data.publishDate}
                tags={post.data.tags}
                slug={post.id}
                readingTime={readingTime(post.body ?? '')}
              />
            ))}
          </div>
          <a href="/blog" class="btn btn--ghost btn--sm writing__more">All posts →</a>
        </div>
      </section>
    )}

    <CtaBand
      title="The conversation costs an hour. Waiting is billed by the quarter."
      body="A short call now, or the same call a few releases from now — the only difference is what it costs to catch up."
    />
  </main>
  <SiteFooter />
</Layout>

<style>
  .services__title { font-size: var(--text-2xl); margin: 0.5rem 0 var(--space-md); }
  .services__grid { display: grid; grid-template-columns: 1fr; gap: var(--space-sm); }

  .method__title { font-size: var(--text-2xl); margin: 0.5rem 0 var(--space-lg); }
  .method__list { display: grid; grid-template-columns: 1fr; gap: var(--space-lg); }
  .method__list li { display: flex; gap: var(--space-sm); align-items: flex-start; }
  .method__num { font-family: var(--font-mono); color: var(--color-muted); font-size: var(--text-sm); flex: none; padding-top: 0.2em; }
  .method__list h3 { font-size: var(--text-lg); margin-bottom: 0.4rem; }
  .method__list p { color: var(--color-muted); max-width: 42ch; }

  .writing__title { font-size: var(--text-2xl); margin: 0.5rem 0 var(--space-md); }
  .writing__grid { display: grid; grid-template-columns: 1fr; gap: var(--space-md); margin-bottom: var(--space-md); }
  .writing__more { display: inline-flex; }

  .open-work__title { font-size: var(--text-2xl); margin: 0.5rem 0 0.6rem; max-width: 26ch; }
  .open-work__note { color: var(--color-muted); max-width: 54ch; margin-bottom: var(--space-lg); }
  .open-work__grid { display: grid; grid-template-columns: 1fr; gap: var(--space-lg); }
  .open-work__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }

  .open-work__ask,
  .method__ask {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-line);
  }
  .open-work__ask p,
  .method__ask p { font-family: var(--font-display); font-size: var(--text-xl); max-width: 30ch; }

  @media (min-width: 720px) {
    .services__grid { grid-template-columns: repeat(2, 1fr); }
    .method__list { grid-template-columns: repeat(3, 1fr); }
  }

  @media (min-width: 640px) {
    .writing__grid { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 980px) {
    .writing__grid { grid-template-columns: 1fr 1fr 1fr; }
  }

  @media (min-width: 760px) {
    .open-work__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .open-work__ask,
    .method__ask { flex-direction: row; align-items: center; justify-content: space-between; }
  }
</style>
