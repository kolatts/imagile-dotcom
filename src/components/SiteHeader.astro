---
const nav = [
  { href: '/services', label: 'Services' },
  { href: '/work', label: 'Work' },
  { href: '/about', label: 'About' },
  { href: '/blog', label: 'Blog' },
];
const current = Astro.url.pathname;
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="site-header__logo" aria-label="Imagile home">
      <svg viewBox="0 0 32 32" width="22" height="22" aria-hidden="true" class="site-header__mark">
        <circle cx="16" cy="8.5" r="2.25" fill="none" stroke="currentColor" stroke-width="2" />
        <line x1="16" y1="10.5" x2="9.5" y2="26" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        <line x1="16" y1="10.5" x2="22.5" y2="26" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        <circle cx="9.5" cy="26.5" r="1.4" fill="currentColor" />
        <circle cx="22.5" cy="26.5" r="1.6" fill="var(--color-accent)" />
      </svg>
      imagile
    </a>

    <input type="checkbox" id="nav-toggle" class="site-header__toggle-input" aria-hidden="true" />
    <label for="nav-toggle" class="site-header__toggle" aria-label="Open menu">
      <span></span><span></span><span></span>
    </label>

    <nav class="site-header__nav" aria-label="Primary">
      <ul>
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={current.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
      <a href="/contact" class="btn btn--primary btn--sm site-header__cta">Contact</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    border-bottom: 1px solid var(--color-line);
    background: color-mix(in oklab, var(--color-bg) 92%, transparent);
    backdrop-filter: blur(10px);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 64px;
  }

  .site-header__logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-right: auto;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.2rem;
    letter-spacing: -0.01em;
  }

  .site-header__mark { color: var(--color-ink); flex: none; }

  .site-header__toggle-input { display: none; }

  .site-header__toggle {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    cursor: pointer;
  }

  .site-header__toggle span {
    display: block;
    width: 20px;
    height: 2px;
    margin-inline: auto;
    background: var(--color-ink);
    transition: transform var(--duration-fast) var(--ease-out), opacity var(--duration-fast) var(--ease-out);
  }

  .site-header__nav ul {
    display: flex;
    gap: 1.6rem;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: var(--text-sm);
  }

  .site-header__nav a[aria-current='page'] { color: var(--color-accent); }
  .site-header__nav a:hover { color: var(--color-accent); }

  .site-header__nav { display: flex; align-items: center; gap: 1.4rem; }

  @media (max-width: 760px) {
    .site-header__nav {
      position: fixed;
      inset: 64px 0 0 auto;
      width: min(78vw, 320px);
      height: calc(100svh - 64px);
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-lg);
      padding: var(--space-lg) var(--space-md);
      background: var(--color-bg);
      border-left: 1px solid var(--color-line);
      transform: translateX(100%);
      transition: transform var(--duration-base) var(--ease-out);
      overflow-y: auto;
    }

    .site-header__nav ul { flex-direction: column; gap: 1.1rem; font-size: var(--text-lg); }
    .site-header__cta { width: 100%; }

    #nav-toggle:checked ~ .site-header__nav { transform: translateX(0); }
    #nav-toggle:checked ~ .site-header__toggle span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    #nav-toggle:checked ~ .site-header__toggle span:nth-child(2) { opacity: 0; }
    #nav-toggle:checked ~ .site-header__toggle span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
  }

  @media (min-width: 761px) {
    .site-header__toggle { display: none; }
  }
</style>
