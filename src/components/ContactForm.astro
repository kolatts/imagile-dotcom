---
interface Props {
  defaultInterest?: string;
}
const { defaultInterest } = Astro.props;

const services = [
  { value: 'ai-transformation-strategy', label: 'AI Transformation Strategy' },
  { value: 'developer-training', label: 'Developer Training' },
  { value: 'business-process-automation', label: 'Business Process Automation' },
  { value: 'custom-software', label: 'Custom Software' },
  { value: 'fractional-cto', label: 'Technical Advisory / Fractional CTO' },
  { value: 'not-sure', label: "Not sure yet" },
];
---

<form id="contact-form" class="contact-form" novalidate>
  <div class="contact-form__row">
    <label for="cf-name">Name</label>
    <input id="cf-name" name="name" type="text" autocomplete="name" required minlength="2" />
  </div>

  <div class="contact-form__row">
    <label for="cf-email">Email</label>
    <input id="cf-email" name="email" type="email" inputmode="email" autocomplete="email" required />
  </div>

  <div class="contact-form__row">
    <label for="cf-company">Company <span class="contact-form__optional">(optional)</span></label>
    <input id="cf-company" name="company" type="text" autocomplete="organization" />
  </div>

  <div class="contact-form__row">
    <label for="cf-interest">What's this about</label>
    <select id="cf-interest" name="interest">
      {services.map((s) => (
        <option value={s.value} selected={s.value === defaultInterest}>{s.label}</option>
      ))}
    </select>
  </div>

  <div class="contact-form__row">
    <label for="cf-message">Message</label>
    <textarea id="cf-message" name="message" rows="6" required minlength="10" maxlength="5000"></textarea>
  </div>

  <!-- Honeypot: visible in the DOM (not display:none) so bots that fill every
       field trip it, but visually hidden and unreachable by keyboard for
       real visitors. Server rejects any submission where this is non-empty. -->
  <div class="contact-form__honeypot" aria-hidden="true">
    <label for="cf-website">Website</label>
    <input id="cf-website" name="websiteUrl" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <input type="hidden" name="sourceUrl" id="cf-source" />

  <div class="cf-turnstile" data-sitekey={import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '0x4AAAAAAED2hq95425ROypd'}></div>

  <button type="submit" class="btn btn--primary contact-form__submit">
    <span class="contact-form__submit-label">Send it</span>
  </button>

  <p class="contact-form__fallback">
    Prefer email? <a href="mailto:sunny@imagile.dev">sunny@imagile.dev</a>
  </p>

  <div class="contact-form__status" role="status" aria-live="polite"></div>

  <noscript>
    <p class="contact-form__noscript">
      This form needs JavaScript for spam protection. Email me instead:
      <a href="mailto:sunny@imagile.dev">sunny@imagile.dev</a>
    </p>
  </noscript>
</form>

<div id="cf-success" class="contact-success" hidden tabindex="-1">
  <svg class="contact-success__check" viewBox="0 0 52 52" aria-hidden="true">
    <circle class="contact-success__circle" cx="26" cy="26" r="23" fill="none" />
    <path class="contact-success__tick" fill="none" d="M15 27l8 8 15-16" />
  </svg>
  <h3 class="contact-success__title">Landed.</h3>
  <p class="contact-success__body">
    Thanks<span id="cf-success-name"></span> — your message is in my inbox. Expect a personal reply
    at <strong id="cf-success-email"></strong> within one business day.
  </p>
  <p class="contact-success__meta">
    Forgot something? Email <a href="mailto:sunny@imagile.dev">sunny@imagile.dev</a> or
    <button type="button" class="contact-success__again" id="cf-again">send another message</button>.
  </p>
</div>

<script>
  const INTAKE_URL = `${import.meta.env.PUBLIC_INTAKE_API_URL || 'https://api.imagile.dev'}/api/intake/contact`;

  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const sourceField = document.getElementById('cf-source') as HTMLInputElement | null;
  if (sourceField) sourceField.value = window.location.href;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const status = form.querySelector('.contact-form__status') as HTMLElement;
    const submitBtn = form.querySelector('.contact-form__submit') as HTMLButtonElement;
    const submitLabel = form.querySelector('.contact-form__submit-label') as HTMLElement;

    const data = new FormData(form);
    const turnstileToken = (window as any).turnstile?.getResponse?.() ?? '';

    const payload = {
      name: data.get('name'),
      email: data.get('email'),
      company: data.get('company') || null,
      interest: data.get('interest'),
      message: data.get('message'),
      turnstileToken,
      sourceUrl: data.get('sourceUrl'),
      websiteUrl: data.get('websiteUrl'),
    };

    submitBtn.disabled = true;
    submitLabel.textContent = 'Sending…';
    status.textContent = '';
    status.className = 'contact-form__status';

    try {
      const res = await fetch(INTAKE_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      if (res.ok) {
        const panel = document.getElementById('cf-success');
        const nameSlot = document.getElementById('cf-success-name');
        const emailSlot = document.getElementById('cf-success-email');
        const firstName = String(data.get('name') || '').trim().split(/\s+/)[0];
        if (nameSlot) nameSlot.textContent = firstName ? `, ${firstName}` : '';
        if (emailSlot) emailSlot.textContent = String(data.get('email') || '');

        form.hidden = true;
        if (panel) {
          panel.hidden = false;
          const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          panel.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'center' });
          panel.focus({ preventScroll: true });
        }
        (window as any).trackEvent?.('ContactSubmitted');
        return;
      }

      if (res.status === 429) {
        status.textContent = "Too many tries from this connection — give it ten minutes, or just email me at sunny@imagile.dev.";
      } else {
        const body = await res.json().catch(() => null);
        status.textContent = body?.detail || body?.title || 'Something went wrong on my end. Your message is still in the box below — try again, or email sunny@imagile.dev.';
      }
      status.className = 'contact-form__status contact-form__status--error';
      (window as any).trackEvent?.('ContactFailed', { reason: String(res.status) });
    } catch {
      status.className = 'contact-form__status contact-form__status--error';
      status.textContent = 'Network hiccup — your message is still in the box below. Try again, or email sunny@imagile.dev.';
      (window as any).trackEvent?.('ContactFailed', { reason: 'network' });
    } finally {
      submitBtn.disabled = false;
      submitLabel.textContent = 'Send it';
      (window as any).turnstile?.reset?.();
    }
  });

  document.getElementById('cf-again')?.addEventListener('click', () => {
    const panel = document.getElementById('cf-success');
    if (panel) panel.hidden = true;
    if (form) {
      form.reset();
      form.hidden = false;
      (document.getElementById('cf-name') as HTMLInputElement | null)?.focus();
    }
    (window as any).turnstile?.reset?.();
  });
</script>

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<style>
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    max-width: 40rem;
  }

  /* The flex display above outranks the UA's [hidden] rule. */
  .contact-form[hidden] { display: none; }

  .contact-form__row { display: flex; flex-direction: column; gap: 0.4rem; }

  .contact-form__row label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .contact-form__optional { text-transform: none; letter-spacing: 0; }

  .contact-form input,
  .contact-form select,
  .contact-form textarea {
    min-height: 44px;
    border: 1px solid var(--color-line-strong);
    background: var(--color-surface);
    color: var(--color-ink);
    padding: 0.65rem 0.8rem;
    font-size: var(--text-base);
    border-radius: var(--radius-sm);
  }

  .contact-form textarea { min-height: 10rem; resize: vertical; }

  .contact-form input:focus-visible,
  .contact-form select:focus-visible,
  .contact-form textarea:focus-visible { border-color: var(--color-accent); }

  .contact-form__honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .contact-form__submit { align-self: flex-start; margin-top: 0.25rem; }

  .contact-form__fallback { font-size: var(--text-sm); color: var(--color-muted); }
  .contact-form__fallback a { color: var(--color-accent); text-decoration: underline; }

  .contact-form__status { font-size: var(--text-base); }
  .contact-form__status--success { color: var(--color-accent); font-size: var(--text-lg); font-weight: 500; }
  .contact-form__status--error { color: #c0392b; }

  .contact-form__noscript { color: var(--color-muted); font-size: var(--text-sm); }

  .contact-success {
    max-width: 40rem;
    background: var(--color-surface);
    border: 1px solid var(--color-line-strong);
    border-top: 3px solid var(--color-accent);
    border-radius: var(--radius-md);
    padding: var(--space-lg) var(--space-md);
    outline: none;
    animation: cf-success-in 0.45s var(--ease-out) both;
  }

  .contact-success__check {
    width: 52px;
    height: 52px;
    margin-bottom: var(--space-xs);
    color: var(--color-accent);
  }

  .contact-success__circle {
    stroke: currentColor;
    stroke-width: 2.5;
    stroke-dasharray: 145;
    stroke-dashoffset: 145;
    animation: cf-draw 0.6s var(--ease-out) 0.15s forwards;
  }

  .contact-success__tick {
    stroke: currentColor;
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 34;
    stroke-dashoffset: 34;
    animation: cf-draw 0.35s var(--ease-out) 0.65s forwards;
  }

  .contact-success__title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    margin-bottom: 0.5rem;
  }

  .contact-success__body { font-size: var(--text-lg); max-width: 46ch; }

  .contact-success__meta {
    margin-top: var(--space-sm);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .contact-success__meta a { color: var(--color-accent); text-decoration: underline; }

  .contact-success__again {
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    color: var(--color-accent);
    text-decoration: underline;
    cursor: pointer;
  }

  @keyframes cf-success-in {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: none; }
  }

  @keyframes cf-draw {
    to { stroke-dashoffset: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-success { animation: none; }
    .contact-success__circle,
    .contact-success__tick { animation: none; stroke-dashoffset: 0; }
  }
</style>
