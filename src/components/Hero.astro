---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle: string;
  primaryCta?: { href: string; label: string };
  secondaryCta?: { href: string; label: string };
  size?: 'lg' | 'md';
  showMark?: boolean;
  /** Replaces the default reticle with a mounted technical-drawing image (path under public/). */
  markImage?: string;
}

const { eyebrow, title, subtitle, primaryCta, secondaryCta, size = 'lg', showMark = true, markImage } = Astro.props;
---

<section class={`hero hero--${size} grid-ground`}>
  <canvas class="hero__ambient" data-ambient aria-hidden="true"></canvas>
  <div class="container hero__inner">
    <div class="hero__copy">
      {eyebrow && <p class="eyebrow" set:html={eyebrow} />}
      <h1 class="hero__title" set:html={title} />
      <p class="hero__subtitle">{subtitle}</p>
      {(primaryCta || secondaryCta) && (
        <div class="hero__actions">
          {primaryCta && <a href={primaryCta.href} class="btn btn--primary">{primaryCta.label}</a>}
          {secondaryCta && <a href={secondaryCta.href} class="btn btn--ghost">{secondaryCta.label}</a>}
        </div>
      )}
    </div>

    {markImage && (
      <div class="hero__drawing" aria-hidden="true">
        <img src={markImage} alt="" width="960" height="640" loading="eager" decoding="async" />
      </div>
    )}

    {showMark && !markImage && (
      <div class="hero__mark" aria-hidden="true">
        <svg viewBox="0 0 400 400" width="100%" height="100%">
          <g data-parallax="0.03" opacity="0.4">
            <circle cx="200" cy="200" r="160" fill="none" stroke="var(--color-ink)" stroke-width="1.25" stroke-dasharray="2 10" />
          </g>
          <g data-parallax="0.08" opacity="0.6">
            <circle cx="200" cy="200" r="105" fill="none" stroke="var(--color-ink)" stroke-width="1.5" stroke-dasharray="2 7" />
          </g>
          <g data-parallax="0.15">
            <circle cx="200" cy="200" r="52" fill="none" stroke="var(--color-ink)" stroke-width="2" />
            <line x1="200" y1="122" x2="200" y2="162" stroke="var(--color-ink)" stroke-width="2" stroke-linecap="round" />
            <line x1="200" y1="238" x2="200" y2="278" stroke="var(--color-ink)" stroke-width="2" stroke-linecap="round" />
            <line x1="122" y1="200" x2="162" y2="200" stroke="var(--color-ink)" stroke-width="2" stroke-linecap="round" />
            <line x1="238" y1="200" x2="278" y2="200" stroke="var(--color-ink)" stroke-width="2" stroke-linecap="round" />
            <circle cx="200" cy="200" r="5" fill="var(--color-accent)" />
          </g>
        </svg>
      </div>
    )}
  </div>
</section>

<style>
  .hero { position: relative; padding-block: var(--space-2xl) var(--space-xl); overflow: clip; }
  .hero--md { padding-block: var(--space-xl) var(--space-lg); }

  .hero__ambient {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
    align-items: center;
    max-width: 100%;
  }

  .hero__copy { max-width: 46ch; }
  .hero__title {
    font-size: var(--text-display);
    line-height: 0.98;
    letter-spacing: -0.02em;
    margin: var(--space-sm) 0 var(--space-md);
  }
  .hero--md .hero__title { font-size: var(--text-3xl); margin-bottom: var(--space-sm); }

  .hero__title :global(em) {
    font-style: normal;
    color: var(--color-accent);
  }

  .hero__subtitle {
    font-size: var(--text-lg);
    color: var(--color-muted);
    line-height: var(--leading-normal);
    margin-bottom: var(--space-md);
    max-width: 52ch;
  }

  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }

  .hero__mark {
    display: none;
    position: absolute;
    top: -8%;
    right: -6%;
    width: min(480px, 42vw);
    aspect-ratio: 1;
    pointer-events: none;
  }

  /* A generated technical drawing, mounted like a print pinned to the board:
     hard border, slight tilt, paper background left visible on purpose so it
     reads as an artifact in dark mode rather than fighting the theme. */
  .hero__drawing {
    display: none;
    position: absolute;
    right: 0;
    top: 50%;
    width: min(440px, 36vw);
    border: 1px solid var(--color-line-strong);
    background: #f6f7f6;
    padding: 6px;
    transform: translateY(-50%) rotate(-1.2deg);
    box-shadow: 0 12px 32px rgba(10, 12, 14, 0.14);
  }

  .hero__drawing img { width: 100%; height: auto; display: block; }

  @media (min-width: 860px) {
    .hero__mark { display: block; }
    .hero__drawing { display: block; }
  }
</style>
