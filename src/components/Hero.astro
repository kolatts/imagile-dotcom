---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle: string;
  primaryCta?: { href: string; label: string };
  secondaryCta?: { href: string; label: string };
  size?: 'lg' | 'md';
  showMark?: boolean;
  /** Replaces the default reticle with a mounted technical-drawing image (path under public/). */
  markImage?: string;
}

const { eyebrow, title, subtitle, primaryCta, secondaryCta, size = 'lg', showMark = true, markImage } = Astro.props;
---

<section class={`hero hero--${size} grid-ground`}>
  <div class="hero__streaks" aria-hidden="true">
    <i></i><i></i><i></i><i></i><i></i>
  </div>
  <div class="container hero__inner">
    <div class="hero__copy">
      {eyebrow && <p class="eyebrow" set:html={eyebrow} />}
      <h1 class="hero__title" set:html={title} />
      <p class="hero__subtitle">{subtitle}</p>
      {(primaryCta || secondaryCta) && (
        <div class="hero__actions">
          {primaryCta && <a href={primaryCta.href} class="btn btn--primary">{primaryCta.label}</a>}
          {secondaryCta && <a href={secondaryCta.href} class="btn btn--ghost">{secondaryCta.label}</a>}
        </div>
      )}
    </div>

    {markImage && (
      <div class="hero__drawing" aria-hidden="true">
        <img src={markImage} alt="" width="960" height="640" loading="eager" decoding="async" />
      </div>
    )}

    {showMark && !markImage && (
      <div class="hero__mark" aria-hidden="true">
        <div class="hero__clock" data-parallax="0.1">
          <img
            class="hero__clock-face"
            src="/images/hero-clockface.webp"
            alt=""
            width="720"
            height="720"
            loading="lazy"
            decoding="async"
          />
          <div class="hero__clock-hand hero__clock-hand--hour"></div>
          <div class="hero__clock-hand hero__clock-hand--minute"></div>
          <div class="hero__clock-hand hero__clock-hand--second"></div>
          <div class="hero__clock-cap"></div>
        </div>
        <p class="hero__elapsed">T+<span data-elapsed>00:00</span> on this page</p>
      </div>
    )}

    <script is:inline>
      // Set the hero clock to the visitor's real time; CSS animations sweep
      // the hands forward from there. The elapsed ticker counts time spent
      // on this page -- the honest version of "the clock is running."
      (function () {
        var clock = document.querySelector('.hero__clock');
        if (clock) {
          var now = new Date();
          var s = now.getSeconds() + now.getMilliseconds() / 1000;
          var m = now.getMinutes() + s / 60;
          var h = (now.getHours() % 12) + m / 60;
          clock.style.setProperty('--sec0', s * 6 + 'deg');
          clock.style.setProperty('--min0', m * 6 + 'deg');
          clock.style.setProperty('--hr0', h * 30 + 'deg');
        }
        var el = document.querySelector('[data-elapsed]');
        if (el) {
          var t0 = Date.now();
          setInterval(function () {
            var total = Math.floor((Date.now() - t0) / 1000);
            var mm = Math.floor(total / 60);
            var ss = total % 60;
            el.textContent = (mm < 10 ? '0' : '') + mm + ':' + (ss < 10 ? '0' : '') + ss;
          }, 1000);
        }
      })();
    </script>
  </div>
</section>

<style>
  .hero { position: relative; padding-block: var(--space-2xl) var(--space-xl); overflow: clip; }
  .hero--md { padding-block: var(--space-xl) var(--space-lg); }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
    align-items: center;
    max-width: 100%;
  }

  .hero__copy { position: relative; z-index: 1; max-width: 46ch; }
  .hero__title {
    font-size: var(--text-display);
    line-height: 1.04;
    letter-spacing: -0.01em;
    margin: var(--space-sm) 0 var(--space-md);
  }
  .hero--md .hero__title { font-size: var(--text-3xl); margin-bottom: var(--space-sm); }

  .hero__title :global(em) {
    font-style: normal;
    color: var(--color-accent);
  }

  .hero__subtitle {
    font-size: var(--text-lg);
    color: var(--color-muted);
    line-height: var(--leading-normal);
    margin-bottom: var(--space-md);
    max-width: 52ch;
  }

  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }

  /* On mobile the clock stays, but as a faded backdrop behind the copy —
     the working hands still sweep, just ghosted into the background. */
  .hero__mark {
    position: absolute;
    top: 50%;
    right: -14%;
    width: min(340px, 84vw);
    aspect-ratio: 1;
    transform: translateY(-52%);
    pointer-events: none;
    opacity: 0.12;
  }

  /* A working clock: generated dial, real hands set to the visitor's time
     by the inline script (--hr0/--min0/--sec0), swept forward by CSS. */
  .hero__clock {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
  }

  .hero__clock-face {
    width: 100%;
    height: auto;
    opacity: 0.94;
  }

  .hero__clock-hand {
    position: absolute;
    left: 50%;
    bottom: 50%;
    transform-origin: 50% 100%;
    border-radius: 999px;
    background: var(--color-ink);
  }

  .hero__clock-hand--hour {
    width: 2.4%;
    height: 22%;
    margin-left: -1.2%;
    transform: rotate(var(--hr0, 305deg));
  }

  .hero__clock-hand--minute {
    width: 1.6%;
    height: 32%;
    margin-left: -0.8%;
    transform: rotate(var(--min0, 118deg));
  }

  .hero__clock-hand--second {
    width: 0.7%;
    height: 38%;
    margin-left: -0.35%;
    background: var(--color-accent);
    transform: rotate(var(--sec0, 0deg));
  }

  .hero__clock-cap {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 3.4%;
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: var(--color-accent);
    border: 2px solid var(--color-bg);
  }

  .hero__elapsed {
    display: none;
    margin-top: var(--space-2xs);
    text-align: center;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    color: var(--color-muted);
  }

  .hero__elapsed span { color: var(--color-accent); font-variant-numeric: tabular-nums; }

  @media (prefers-reduced-motion: no-preference) {
    .hero__clock-hand--second { animation: sweep-sec 60s linear infinite; }
    .hero__clock-hand--minute { animation: sweep-min 3600s linear infinite; }
    .hero__clock-hand--hour { animation: sweep-hr 43200s linear infinite; }
  }

  @keyframes sweep-sec {
    from { transform: rotate(var(--sec0, 0deg)); }
    to { transform: rotate(calc(var(--sec0, 0deg) + 360deg)); }
  }

  @keyframes sweep-min {
    from { transform: rotate(var(--min0, 118deg)); }
    to { transform: rotate(calc(var(--min0, 118deg) + 360deg)); }
  }

  @keyframes sweep-hr {
    from { transform: rotate(var(--hr0, 305deg)); }
    to { transform: rotate(calc(var(--hr0, 305deg) + 360deg)); }
  }

  /* Dial art is warm near-black over transparency; in dark mode flip its
     lightness while keeping the terracotta accent roughly in place. The
     hands live outside the img so they take theme tokens directly. */
  @media (prefers-color-scheme: dark) {
    .hero__clock-face {
      filter: invert(1) hue-rotate(180deg) saturate(1.3) brightness(1.05);
      opacity: 0.9;
    }
  }

  /* Blurred speed streaks: three soft trails drifting through the hero on
     long staggered cycles. Blur is static; only transform animates. */
  .hero__streaks {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    display: none;
  }

  .hero__streaks i {
    position: absolute;
    left: -55%;
    width: 52%;
    height: 110px;
    border-radius: 999px;
    background: linear-gradient(90deg, transparent, color-mix(in oklab, var(--color-accent) 60%, transparent) 55%, transparent);
    filter: blur(22px);
    opacity: 0.22;
    transform: rotate(-10deg);
  }

  .hero__streaks i:nth-child(1) { top: 12%; }
  .hero__streaks i:nth-child(2) {
    top: 34%;
    height: 64px;
    background: linear-gradient(90deg, transparent, color-mix(in oklab, var(--color-ink) 55%, transparent) 55%, transparent);
    opacity: 0.14;
  }
  .hero__streaks i:nth-child(3) { top: 52%; height: 88px; opacity: 0.18; }
  .hero__streaks i:nth-child(4) {
    top: 68%;
    height: 52px;
    background: linear-gradient(90deg, transparent, color-mix(in oklab, var(--color-ink) 50%, transparent) 55%, transparent);
    opacity: 0.12;
  }
  .hero__streaks i:nth-child(5) { top: 84%; height: 72px; opacity: 0.16; }

  @media (prefers-reduced-motion: no-preference) {
    .hero__streaks i { animation: streak-drift 7s linear infinite; }
    .hero__streaks i:nth-child(2) { animation-duration: 9.5s; animation-delay: -4s; }
    .hero__streaks i:nth-child(3) { animation-duration: 6s; animation-delay: -2.5s; }
    .hero__streaks i:nth-child(4) { animation-duration: 11s; animation-delay: -7s; }
    .hero__streaks i:nth-child(5) { animation-duration: 8s; animation-delay: -5.5s; }
  }

  @keyframes streak-drift {
    from { transform: translateX(0) rotate(-10deg); }
    to { transform: translateX(400%) rotate(-10deg); }
  }

  @media (min-width: 860px) {
    .hero__streaks { display: block; }
  }

  /* A generated technical drawing, mounted like a print pinned to the board:
     hard border, slight tilt, paper background left visible on purpose so it
     reads as an artifact in dark mode rather than fighting the theme. */
  .hero__drawing {
    display: none;
    position: absolute;
    right: 0;
    top: 50%;
    width: min(440px, 36vw);
    border: 1px solid var(--color-line-strong);
    background: #f6f7f6;
    padding: 6px;
    transform: translateY(-50%) rotate(-1.2deg);
    box-shadow: 0 12px 32px rgba(10, 12, 14, 0.14);
  }

  .hero__drawing img { width: 100%; height: auto; display: block; }

  @media (min-width: 860px) {
    .hero__mark {
      right: -2%;
      width: min(430px, 36vw);
      opacity: 1;
    }
    .hero__elapsed { display: block; }
    .hero__drawing { display: block; }
  }
</style>
