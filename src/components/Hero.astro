---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle: string;
  primaryCta?: { href: string; label: string };
  secondaryCta?: { href: string; label: string };
  size?: 'lg' | 'md';
  showMark?: boolean;
}

const { eyebrow, title, subtitle, primaryCta, secondaryCta, size = 'lg', showMark = true } = Astro.props;
---

<section class={`hero hero--${size} grid-ground`}>
  <canvas class="hero__ambient" data-ambient aria-hidden="true"></canvas>
  <div class="container hero__inner">
    <div class="hero__copy">
      {eyebrow && <p class="eyebrow" set:html={eyebrow} />}
      <h1 class="hero__title" set:html={title} />
      <p class="hero__subtitle">{subtitle}</p>
      {(primaryCta || secondaryCta) && (
        <div class="hero__actions">
          {primaryCta && <a href={primaryCta.href} class="btn btn--primary">{primaryCta.label}</a>}
          {secondaryCta && <a href={secondaryCta.href} class="btn btn--ghost">{secondaryCta.label}</a>}
        </div>
      )}
    </div>

    {showMark && (
      <div class="hero__mark" data-parallax="0.08" aria-hidden="true">
        <svg viewBox="0 0 220 260" width="100%" height="100%">
          <g fill="none" stroke="var(--color-line-strong)" stroke-width="1.5">
            <circle cx="110" cy="30" r="9" />
            <line x1="110" y1="39" x2="55" y2="220" />
            <line x1="110" y1="39" x2="165" y2="220" />
            <path d="M 55 220 A 55 55 0 0 0 165 220" stroke-dasharray="2 5" />
          </g>
          <circle cx="55" cy="222" r="4" fill="var(--color-line-strong)" />
          <circle cx="165" cy="222" r="6" fill="var(--color-accent)" />
        </svg>
      </div>
    )}
  </div>
</section>

<style>
  .hero { position: relative; padding-block: var(--space-2xl) var(--space-xl); overflow: clip; }
  .hero--md { padding-block: var(--space-xl) var(--space-lg); }

  .hero__ambient {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
    align-items: center;
  }

  .hero__copy { max-width: 46ch; }
  .hero__title {
    font-size: var(--text-display);
    line-height: 0.98;
    letter-spacing: -0.02em;
    margin: var(--space-sm) 0 var(--space-md);
  }
  .hero--md .hero__title { font-size: var(--text-3xl); margin-bottom: var(--space-sm); }

  .hero__title :global(em) {
    font-style: normal;
    color: var(--color-accent);
  }

  .hero__subtitle {
    font-size: var(--text-lg);
    color: var(--color-muted);
    line-height: var(--leading-normal);
    margin-bottom: var(--space-md);
    max-width: 52ch;
  }

  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }

  .hero__mark {
    display: none;
    justify-self: end;
    width: min(220px, 30vw);
  }

  @media (min-width: 860px) {
    .hero__inner { grid-template-columns: 1fr auto; }
    .hero__mark { display: block; }
  }
</style>
