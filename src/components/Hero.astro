---
import MorphWord from './hero/MorphWord.astro';
import HeroGlyph from './hero/HeroGlyph.astro';
---

<section class="hero">
  <div class="container hero-grid">
    <div class="hero-text">
      <p class="eyebrow badge">
        <span class="badge-dot"></span>
        AI Consulting &amp; Training
      </p>

      <h1 class="hero-title">
        Make your org <span class="line-accent">actually</span><br />
        <MorphWord words={['fluent', 'dangerous', 'fast', 'useful']} /> in AI.
      </h1>

      <p class="hero-desc">
        We're a small firm of senior engineers. We teach AI fluency, we build
        .NET and Azure systems, and we advise the people betting their
        company on getting technology right.
      </p>

      <div class="hero-cta">
        <a href="/contact" class="btn" data-track="HeroCTA_Contact">Start a Conversation</a>
        <a href="/services" class="btn-text">Explore services &rarr;</a>
      </div>
    </div>

    <div class="hero-visual">
      <HeroGlyph />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    z-index: var(--z-content);
    min-height: 92vh;
    display: flex;
    align-items: center;
    padding-top: 6rem;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    align-items: center;
    gap: var(--space-lg);
  }

  .badge {
    display: inline-flex;
    border: 1px solid rgba(255, 107, 0, 0.3);
    padding: 0.4rem 0.9rem;
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-md);
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-primary);
    align-self: center;
    animation: blink 2.4s ease infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }

  .hero-title {
    margin-bottom: var(--space-md);
  }

  .line-accent {
    font-family: var(--font-accent);
    font-style: italic;
    text-transform: none;
    color: var(--color-text-secondary);
    letter-spacing: 0;
  }

  .hero-desc {
    font-size: clamp(1rem, 1.4vw, 1.2rem);
    max-width: 480px;
    margin-bottom: var(--space-lg);
  }

  .hero-cta {
    display: flex;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .hero-visual {
    display: flex;
    align-items: center;
    justify-content: center;
    perspective: 1000px;
  }

  @media (prefers-reduced-motion: reduce) {
    .badge-dot {
      animation: none;
    }
  }

  @media (max-width: 900px) {
    .hero {
      min-height: auto;
      padding-top: 7rem;
      padding-bottom: var(--space-lg);
    }

    .hero-grid {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .hero-desc {
      margin-left: auto;
      margin-right: auto;
    }

    .hero-cta {
      justify-content: center;
    }

    /* Not display:none -- a small centered mark instead of losing the
       visual entirely on mobile. */
    .hero-visual {
      transform: scale(0.4);
      margin: -3rem 0 -3rem;
      opacity: 0.6;
    }
  }
</style>
