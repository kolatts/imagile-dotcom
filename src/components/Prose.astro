---
---
<div class="prose-content">
  <slot />
</div>

<style is:global>
  .prose-content {
    max-width: var(--measure);
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
  }

  .prose-content > * + * { margin-top: 1.3em; }

  .prose-content h2 {
    font-size: var(--text-2xl);
    margin-top: 2em;
    letter-spacing: -0.01em;
  }

  .prose-content h3 {
    font-size: var(--text-xl);
    margin-top: 1.8em;
  }

  .prose-content p { color: var(--color-ink); }

  .prose-content a {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, var(--color-accent) 45%, transparent);
    text-underline-offset: 3px;
  }

  .prose-content ul, .prose-content ol {
    padding-left: 1.4em;
    list-style: disc;
  }
  .prose-content ol { list-style: decimal; }
  .prose-content li + li { margin-top: 0.5em; }

  .prose-content blockquote {
    border-left: 2px solid var(--color-accent);
    padding-left: 1.2em;
    color: var(--color-muted);
    font-style: italic;
  }

  .prose-content code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    padding: 0.1em 0.35em;
    border-radius: var(--radius-sm);
  }

  .prose-content pre {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    padding: var(--space-sm);
    overflow-x: auto;
  }

  .prose-content pre code { border: none; padding: 0; background: none; }

  .prose-content table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-base);
    display: block;
    overflow-x: auto;
  }

  .prose-content th, .prose-content td {
    border: 1px solid var(--color-line);
    padding: 0.5em 0.75em;
    text-align: left;
  }

  .prose-content th { font-family: var(--font-mono); font-size: var(--text-xs); text-transform: uppercase; letter-spacing: 0.05em; }

  .prose-content hr { border: none; border-top: 1px solid var(--color-line); }

  .prose-content img { border: 1px solid var(--color-line); }
</style>
