---
interface Props {
  title: string;
  body?: string;
  cta?: { href: string; label: string };
}
const { title, body, cta = { href: '/contact', label: 'Get in touch' } } = Astro.props;
---

<section class="cta-band grid-ground">
  <svg class="cta-band__mark" viewBox="0 0 300 300" aria-hidden="true">
    <g data-parallax="-0.05" opacity="0.35">
      <circle cx="150" cy="150" r="120" fill="none" stroke="var(--color-ink)" stroke-width="1.25" stroke-dasharray="2 9" />
    </g>
    <g data-parallax="-0.1" opacity="0.55">
      <circle cx="150" cy="150" r="70" fill="none" stroke="var(--color-ink)" stroke-width="1.5" stroke-dasharray="2 6" />
      <circle cx="150" cy="150" r="4" fill="var(--color-accent)" />
    </g>
  </svg>
  <div class="container cta-band__inner" data-reveal>
    <div>
      <h2 class="cta-band__title">{title}</h2>
      {body && <p class="cta-band__body">{body}</p>}
    </div>
    <a href={cta.href} class="btn btn--primary">{cta.label}</a>
  </div>
</section>

<style>
  .cta-band {
    position: relative;
    overflow: clip;
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    padding-block: var(--space-xl);
  }

  .cta-band__mark {
    display: none;
    position: absolute;
    top: 50%;
    left: -5%;
    width: min(340px, 30vw);
    aspect-ratio: 1;
    transform: translateY(-50%);
    pointer-events: none;
  }

  @media (min-width: 860px) {
    .cta-band__mark { display: block; }
  }

  .cta-band__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    align-items: flex-start;
  }

  .cta-band__title { font-size: var(--text-2xl); max-width: 20ch; }
  .cta-band__body { color: var(--color-muted); margin-top: 0.6rem; max-width: 42ch; }

  @media (min-width: 760px) {
    .cta-band__inner { flex-direction: row; align-items: center; justify-content: space-between; }
  }
</style>
