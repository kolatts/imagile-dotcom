---
interface Props {
  title: string;
  body?: string;
  cta?: { href: string; label: string };
}
const { title, body, cta = { href: '/contact', label: 'Book a strategy intensive · $900' } } = Astro.props;
---

<section class="cta-band grid-ground">
  <div class="container cta-band__inner" data-reveal>
    <div>
      <h2 class="cta-band__title">{title}</h2>
      {body && <p class="cta-band__body">{body}</p>}
    </div>
    <a href={cta.href} class="btn btn--primary">{cta.label}</a>
  </div>
</section>

<style>
  .cta-band {
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    padding-block: var(--space-xl);
  }

  .cta-band__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    align-items: flex-start;
  }

  .cta-band__title { font-size: var(--text-2xl); max-width: 20ch; }
  .cta-band__body { color: var(--color-muted); margin-top: 0.6rem; max-width: 42ch; }

  @media (min-width: 760px) {
    .cta-band__inner { flex-direction: row; align-items: center; justify-content: space-between; }
  }
</style>
