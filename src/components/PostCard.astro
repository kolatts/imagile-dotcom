---
interface Props {
  title: string;
  description: string;
  publishDate: Date;
  tags: string[];
  slug: string;
  readingTime?: number;
}

const { title, description, publishDate, tags, slug, readingTime } = Astro.props;

const formattedDate = new Date(publishDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="post-card card" data-reveal>
  <p class="post-card__meta">
    <time datetime={new Date(publishDate).toISOString()} data-relative>{formattedDate}</time>
    {readingTime && <span> · {readingTime} min read</span>}
  </p>
  <h3 class="post-card__title"><a href={`/blog/${slug}`}>{title}</a></h3>
  <p class="post-card__desc">{description}</p>
  {tags.length > 0 && (
    <div class="post-card__tags">
      {tags.slice(0, 3).map((tag) => (
        <a href={`/blog/tag/${tag}`} class="tag-pill">{tag}</a>
      ))}
    </div>
  )}
</article>

<style>
  .post-card { display: flex; flex-direction: column; height: 100%; }
  .post-card__meta {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-muted);
    margin-bottom: 0.7rem;
  }
  .post-card__title { font-size: var(--text-lg); line-height: 1.3; margin-bottom: 0.6rem; }
  .post-card__title a:hover { color: var(--color-accent); }
  .post-card__desc { color: var(--color-muted); font-size: var(--text-sm); margin-bottom: 1rem; }
  .post-card__tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: auto; }
</style>
