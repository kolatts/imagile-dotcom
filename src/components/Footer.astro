---
import { site, footerGroups } from '../lib/site';

const currentYear = new Date().getFullYear();
---

<footer class="footer" id="site-footer">
  <div class="container">
    <div class="footer-content">
      <div class="footer-brand">
        <div class="logo">
          <span class="logo-dot"></span>
          <span class="logo-text">IMAGILE</span>
        </div>
        <p class="footer-tagline">{site.tagline}</p>
      </div>

      <div class="footer-links">
        {footerGroups.map(group => (
          <div class="footer-column">
            <h3 class="footer-heading">{group.heading}</h3>
            <ul>
              {group.links.map(link => (
                <li><a href={link.href}>{link.label}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <div class="footer-bottom">
      <p class="footer-copyright">© {currentYear} Imagile. All rights reserved.</p>
      <a href={`mailto:${site.contactEmail}`} class="footer-email">{site.contactEmail}</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: var(--space-lg) 0 var(--space-md);
    border-top: 1px solid var(--hairline);
  }

  .footer-content {
    display: grid;
    grid-template-columns: 1.4fr 2fr;
    gap: var(--space-lg);
    margin-bottom: var(--space-lg);
  }

  .footer-links {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
  }

  .footer-brand {
    max-width: 420px;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.25rem;
  }

  .logo-text {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--color-text-primary);
  }

  .logo-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-primary);
  }

  .footer-tagline {
    color: var(--color-text-tertiary);
    font-size: 0.9375rem;
    line-height: 1.7;
  }

  .footer-heading {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 1.25rem;
    color: var(--color-text-quaternary);
  }

  .footer-column ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .footer-column a {
    color: var(--color-text-secondary);
    font-size: 0.9375rem;
  }

  .footer-column a:hover {
    color: var(--color-primary);
  }

  .footer-bottom {
    padding-top: var(--space-md);
    border-top: 1px solid var(--hairline);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .footer-copyright {
    color: var(--color-text-quaternary);
    font-size: 0.8125rem;
  }

  .footer-email {
    color: var(--color-text-tertiary);
    font-size: 0.8125rem;
  }

  @media (max-width: 768px) {
    .footer-content {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .footer-links {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem 2rem;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
