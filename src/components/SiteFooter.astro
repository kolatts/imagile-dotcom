---
const year = new Date().getFullYear();
---

<footer class="site-footer grid-ground">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <p class="site-footer__wordmark">imagile</p>
      <p class="site-footer__tagline">AI transformation consulting. Senior-led, hands-on, scoped in the open.</p>
      <p class="site-footer__location">Lewis Center, Ohio — on-site in Central Ohio, remote everywhere else.</p>
    </div>

    <nav class="site-footer__col" aria-label="Services">
      <p class="eyebrow">Services</p>
      <ul>
        <li><a href="/services/developer-training">Developer Training</a></li>
        <li><a href="/services/agentic-workflows">Business Automation</a></li>
        <li><a href="/services/custom-software">Custom Software</a></li>
        <li><a href="/contact">Technical Advisory</a></li>
      </ul>
    </nav>

    <nav class="site-footer__col" aria-label="Site">
      <p class="eyebrow">Site</p>
      <ul>
        <li><a href="/work">Work</a></li>
        <li><a href="/about">About</a></li>
        <li><a href="/blog">Blog</a></li>
        <li><a href="/contact">Contact</a></li>
      </ul>
    </nav>

    <div class="site-footer__col">
      <p class="eyebrow">Elsewhere</p>
      <ul>
        <li><a href="https://context-overflow.dev" target="_blank" rel="noopener">Context Overflow ↗</a></li>
        <li><a href="https://github.com/kolatts" target="_blank" rel="noopener">GitHub ↗</a></li>
        <li><a href="https://linkedin.com/in/sunnyjk" target="_blank" rel="noopener">LinkedIn ↗</a></li>
      </ul>
    </div>
  </div>

  <div class="container site-footer__bottom">
    <p>&copy; {year} Sunny Kolattukudy, doing business as Imagile.</p>
    <p><a href="/rss.xml">RSS</a></p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-line);
    padding-block: var(--space-xl) var(--space-md);
  }

  .site-footer__inner {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: var(--space-lg) var(--space-md);
    padding-bottom: var(--space-lg);
  }

  .site-footer__wordmark {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
    margin-bottom: 0.6rem;
  }

  .site-footer__tagline { color: var(--color-muted); font-size: var(--text-sm); max-width: 32ch; margin-bottom: 0.5rem; }
  .site-footer__location { color: var(--color-muted); font-size: var(--text-xs); font-family: var(--font-mono); }

  .site-footer__col .eyebrow { margin-bottom: 0.9rem; }
  .site-footer__col ul { display: flex; flex-direction: column; gap: 0.55rem; font-size: var(--text-sm); }
  .site-footer__col a:hover { color: var(--color-accent); }

  .site-footer__bottom {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-line);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .site-footer__bottom a:hover { color: var(--color-accent); }

  @media (max-width: 760px) {
    .site-footer__inner { grid-template-columns: 1fr 1fr; }
    .site-footer__brand { grid-column: 1 / -1; }
    .site-footer__bottom { flex-direction: column; gap: 0.5rem; }
  }
</style>
