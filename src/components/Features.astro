---
const features = [
  {
    title: 'AI & Machine Learning',
    description: 'Intelligent systems powered by cutting-edge AI. From predictive analytics to natural language processing, we build the future.',
    icon: '🤖'
  },
  {
    title: 'Cloud Solutions',
    description: 'Scalable, secure cloud architecture built on Azure. AI-ready infrastructure that grows with your ambitions.',
    icon: '☁️'
  },
  {
    title: 'Custom Development',
    description: 'Tailored software solutions designed to fit your exact needs. No off-the-shelf compromises, just pure innovation.',
    icon: '⚙️'
  },
  {
    title: 'Enterprise Integration',
    description: 'Seamlessly connect your systems with AI-driven automation. Modern APIs, legacy integration, intelligent data flow.',
    icon: '🔗'
  },
  {
    title: 'DevOps & CI/CD',
    description: 'Automated pipelines, continuous deployment, infrastructure as code. Ship faster with AI-assisted workflows.',
    icon: '🚀'
  },
  {
    title: 'Database Design',
    description: 'Optimized data architecture ready for AI workloads. Multi-tenant sharding, performance tuning, intelligent caching.',
    icon: '💾'
  }
];
---

<section class="features" id="services">
  <div class="container">
    <div class="features-header">
      <h2 class="section-title">
        What We <span class="highlight">Build</span>
      </h2>
      <p class="section-description">
        Full-stack expertise across the entire software development lifecycle.
        From initial architecture to production deployment and beyond.
      </p>
    </div>

    <div class="features-grid">
      {features.map((feature, index) => (
        <div class="feature-card" style={`animation-delay: ${index * 0.1}s;`}>
          <div class="feature-icon">{feature.icon}</div>
          <h3 class="feature-title">{feature.title}</h3>
          <p class="feature-description">{feature.description}</p>
          <div class="feature-accent"></div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .features {
    padding: var(--space-xl) 0;
    background: var(--color-bg-medium);
    position: relative;
  }

  .features-header {
    text-align: center;
    max-width: 800px;
    margin: 0 auto var(--space-lg);
  }

  .section-title {
    font-size: clamp(2.5rem, 5vw, 5rem);
    margin-bottom: var(--space-md);
  }

  .section-description {
    font-size: clamp(1.125rem, 1.5vw, 1.5rem);
    color: var(--color-text-secondary);
    margin: 0 auto;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 2rem;
    margin-top: var(--space-lg);
  }

  .feature-card {
    background: var(--color-bg-dark);
    padding: 2.5rem;
    position: relative;
    border: 2px solid transparent;
    transition: all 0.4s ease;
    opacity: 0;
    animation: fadeInUp 0.8s ease-out forwards;
  }

  .feature-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--color-primary);
    transition: width 0.4s ease;
  }

  .feature-card:hover {
    border-color: var(--color-primary);
    transform: translateY(-8px);
  }

  .feature-card:hover::before {
    width: 100%;
  }

  .feature-icon {
    font-size: 3rem;
    margin-bottom: 1.5rem;
    filter: grayscale(100%);
    transition: filter 0.4s ease;
  }

  .feature-card:hover .feature-icon {
    filter: grayscale(0%);
  }

  .feature-title {
    font-size: 1.75rem;
    margin-bottom: 1rem;
    color: var(--color-text-primary);
  }

  .feature-description {
    font-size: 1.125rem;
    color: var(--color-text-secondary);
    line-height: 1.8;
  }

  .feature-accent {
    position: absolute;
    bottom: -2px;
    right: -2px;
    width: 60px;
    height: 60px;
    background: var(--color-primary);
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .feature-card:hover .feature-accent {
    opacity: 0.2;
  }

  @media (max-width: 768px) {
    .features-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .feature-card {
      padding: 2rem;
    }
  }
</style>
