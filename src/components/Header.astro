---
import { primaryNav } from '../lib/site';

const currentPath = Astro.url.pathname;
const isActive = (href: string) => href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="header">
  <div class="container">
    <nav class="nav">
      <a href="/" class="logo">
        <span class="logo-dot"></span>
        IMAGILE
      </a>

      <button class="hamburger" aria-label="Toggle menu" aria-expanded="false" aria-controls="nav-links">
        <span></span>
        <span></span>
        <span></span>
      </button>

      <div class="nav-links" id="nav-links">
        {primaryNav.map(link => (
          <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>{link.label}</a>
        ))}
      </div>
    </nav>
  </div>
</header>

<script>
  const hamburger = document.querySelector<HTMLButtonElement>('.hamburger');
  const navLinks = document.querySelector<HTMLElement>('.nav-links');
  const body = document.body;

  if (hamburger && navLinks) {
    // Inert only applies to the mobile drawer state -- on desktop this same
    // element is the always-visible nav bar and must never be inert.
    const mobileQuery = window.matchMedia('(max-width: 768px)');

    const syncInert = () => {
      const isOpen = hamburger.getAttribute('aria-expanded') === 'true';
      if (mobileQuery.matches && !isOpen) {
        navLinks.setAttribute('inert', '');
      } else {
        navLinks.removeAttribute('inert');
      }
    };
    syncInert();
    mobileQuery.addEventListener('change', syncInert);

    const open = () => {
      hamburger.setAttribute('aria-expanded', 'true');
      hamburger.classList.add('active');
      navLinks.classList.add('active');
      body.classList.add('menu-open');
      syncInert();
      navLinks.querySelector<HTMLElement>('a')?.focus();
    };

    const close = ({ restoreFocus = false }: { restoreFocus?: boolean } = {}) => {
      hamburger.classList.remove('active');
      navLinks.classList.remove('active');
      body.classList.remove('menu-open');
      hamburger.setAttribute('aria-expanded', 'false');
      syncInert();
      if (restoreFocus) {
        hamburger.focus();
      }
    };

    hamburger.addEventListener('click', () => {
      const isExpanded = hamburger.getAttribute('aria-expanded') === 'true';
      isExpanded ? close() : open();
    });

    navLinks.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => close());
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && hamburger.getAttribute('aria-expanded') === 'true') {
        close({ restoreFocus: true });
      }
    });

    document.addEventListener('click', (e) => {
      if (
        hamburger.getAttribute('aria-expanded') === 'true' &&
        !hamburger.contains(e.target as Node) &&
        !navLinks.contains(e.target as Node)
      ) {
        close();
      }
    });
  }
</script>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: var(--z-header);
    background: rgba(8, 8, 8, 0.85);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--hairline);
  }

  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 0;
    position: relative;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-size: 1.05rem;
    letter-spacing: -0.01em;
    color: var(--color-text-primary);
    z-index: 1001;
  }

  .logo:hover {
    color: var(--color-text-primary);
  }

  .logo-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--color-primary);
  }

  .hamburger {
    display: none;
    flex-direction: column;
    gap: 6px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 8px;
    z-index: 1001;
    position: relative;
  }

  .hamburger span {
    display: block;
    width: 26px;
    height: 2px;
    background: var(--color-text-secondary);
    transition: all var(--dur-fast) var(--ease);
    border-radius: 2px;
  }

  .hamburger:hover span {
    background: var(--color-primary);
  }

  .hamburger.active span:nth-child(1) {
    transform: rotate(45deg) translate(8px, 8px);
    background: var(--color-primary);
  }

  .hamburger.active span:nth-child(2) {
    opacity: 0;
  }

  .hamburger.active span:nth-child(3) {
    transform: rotate(-45deg) translate(8px, -8px);
    background: var(--color-primary);
  }

  .nav-links {
    display: flex;
    gap: 2.25rem;
    align-items: center;
  }

  .nav-links a {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    letter-spacing: 0.01em;
    transition: color var(--dur-fast) var(--ease);
    position: relative;
  }

  .nav-links a[aria-current='page'],
  .nav-links a:hover {
    color: var(--color-text-primary);
  }

  .nav-links a[aria-current='page']::after {
    content: '';
    position: absolute;
    bottom: -6px;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--color-primary);
  }

  @media (max-width: 768px) {
    .hamburger {
      display: flex;
    }

    .nav-links {
      position: fixed;
      top: 0;
      right: -100%;
      height: 100vh;
      width: 280px;
      flex-direction: column;
      justify-content: center;
      align-items: flex-start;
      gap: 2rem;
      background: rgba(8, 8, 8, 0.98);
      backdrop-filter: blur(20px);
      padding: 2rem;
      border-left: 1px solid var(--hairline);
      transition: right var(--dur-med) var(--ease);
      z-index: var(--z-drawer);
    }

    .nav-links.active {
      right: 0;
    }

    .nav-links a {
      font-size: 1.25rem;
      padding: 0.75rem 0;
      width: 100%;
      min-height: 44px;
      display: flex;
      align-items: center;
    }
  }

  :global(body.menu-open) {
    overflow: hidden;
  }
</style>
