---
import { site } from '../lib/site';
---

<section class="cta">
  <div class="container">
    <div class="cta-content">
      <h2 class="cta-title">
        Ready to build <span class="highlight">something that ships?</span>
      </h2>
      <p class="cta-description">
        Tell us what you're working on. We'll tell you honestly whether we're the right fit.
      </p>
      <div class="cta-actions">
        <a href="/contact" class="btn" data-track="CTA_Contact">Start a Conversation</a>
        <a href={`mailto:${site.contactEmail}`} class="btn-text" data-track="CTA_Email">
          or email {site.contactEmail}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    padding: var(--space-xl) 0;
    position: relative;
  }

  .cta-content {
    max-width: 780px;
    margin: 0 auto;
    text-align: center;
  }

  .cta-title {
    margin-bottom: var(--space-md);
  }

  .highlight {
    color: var(--color-primary);
  }

  .cta-description {
    font-size: clamp(1.0625rem, 1.4vw, 1.25rem);
    margin: 0 auto var(--space-lg);
    max-width: 560px;
  }

  .cta-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  @media (max-width: 768px) {
    .cta {
      padding: var(--space-lg) 0;
    }
  }
</style>
