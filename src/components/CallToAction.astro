---
---

<section class="cta" id="contact">
  <div class="cta-background">
    <div class="geometric-shape shape-circle" style="top: 20%; left: 10%;"></div>
    <div class="geometric-shape shape-square" style="bottom: 10%; right: 15%;"></div>
  </div>

  <div class="container">
    <div class="cta-content">
      <h2 class="cta-title">
        Ready to Build<br />
        Something <span class="highlight">Exceptional?</span>
      </h2>
      <p class="cta-description">
        Let's discuss your project. Whether you're starting from scratch or scaling an existing system,
        we have the expertise to deliver results.
      </p>
      <div class="cta-actions">
        <a href="mailto:hello@imagile.dev" class="btn" id="cta-button">Get in Touch</a>
        <div class="cta-info">
          <span class="cta-label">Email us at</span>
          <a href="mailto:hello@imagile.dev" class="cta-email" id="cta-email">hello@imagile.dev</a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { trackEvent } from '../lib/appInsights';
  
  // Track CTA button clicks
  document.getElementById('cta-button')?.addEventListener('click', () => {
    trackEvent('CTAButtonClick', { location: 'Contact Section', action: 'Get in Touch' });
  });

  // Track email link clicks
  document.getElementById('cta-email')?.addEventListener('click', () => {
    trackEvent('EmailLinkClick', { location: 'Contact Section', email: 'hello@imagile.dev' });
  });
</script>

<style>
  .cta {
    padding: var(--space-xl) 0;
    background: var(--color-bg-dark);
    position: relative;
    overflow: hidden;
  }

  .cta-background {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .cta-content {
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
    position: relative;
    z-index: 10;
  }

  .cta-title {
    font-size: clamp(2.5rem, 6vw, 6rem);
    margin-bottom: var(--space-md);
    line-height: 1;
  }

  .cta-description {
    font-size: clamp(1.125rem, 1.5vw, 1.5rem);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-lg);
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
  }

  .cta-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
  }

  .cta-info {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .cta-label {
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-secondary);
    font-weight: 600;
  }

  .cta-email {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--color-primary);
    transition: transform 0.3s ease;
    display: inline-block;
  }

  .cta-email:hover {
    transform: scale(1.05);
    color: var(--color-primary-light);
  }

  @media (max-width: 768px) {
    .cta {
      padding: var(--space-lg) 0;
    }

    .cta-actions {
      gap: 1.5rem;
    }

    .cta-email {
      font-size: 1.25rem;
    }
  }
</style>
