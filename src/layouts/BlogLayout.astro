---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { tagHref } from '../lib/paths';
import { getCanonicalTags, getTagMeta } from '../lib/tags';

interface Props {
  frontmatter: {
    title: string;
    description: string;
    publishDate: Date;
    author: string;
    tags: string[];
    image?: string;
  };
  readingTime: number;
}

const { frontmatter, readingTime } = Astro.props;

const formattedDate = new Date(frontmatter.publishDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});

const canonicalTags = getCanonicalTags(frontmatter.tags ?? []);

// Posts about AI training / fluency cross-link the Beyond Boring program page.
// Zero MDX churn required — it applies automatically based on tags.
const showBeyondBoringPanel = canonicalTags.some(tag =>
  ['developer-training', 'ai-training'].includes(tag)
);

const articleMeta = {
  publishedTime: new Date(frontmatter.publishDate).toISOString(),
  author: frontmatter.author,
  tags: frontmatter.tags
};
---

<Layout
  title={frontmatter.title}
  description={frontmatter.description}
  image={frontmatter.image}
  article={articleMeta}
>
  <Header />
  <main id="main">
    <article class="blog-post">
      <a href="/blog/" class="back-to-blog">
        &larr; Back to Blog
      </a>

      <header class="blog-post-header">
        <h1 class="blog-post-title">{frontmatter.title}</h1>

        <div class="blog-post-meta">
          <time datetime={new Date(frontmatter.publishDate).toISOString()}>{formattedDate}</time>
          <span>{frontmatter.author}</span>
          <span>{readingTime} min read</span>
        </div>

        <p class="blog-post-description">{frontmatter.description}</p>

        {canonicalTags.length > 0 && (
          <div class="blog-post-tags">
            {canonicalTags.map(tag => (
              <a href={tagHref(tag)} class="blog-tag">{getTagMeta(tag).label}</a>
            ))}
          </div>
        )}
      </header>

      <div class="prose">
        <slot />
      </div>

      {showBeyondBoringPanel && (
        <aside class="related-program">
          <p class="related-program-eyebrow">Related program</p>
          <p>
            If this is the kind of thing you want your whole team fluent in, that's what
            <a href="/beyond-boring/">Beyond Boring</a> is for.
          </p>
        </aside>
      )}
    </article>
  </main>
  <Footer />
</Layout>

<style>
  .related-program {
    max-width: 800px;
    margin: var(--space-lg) auto 0;
    padding: 1.5rem 2rem;
    border: 1px solid var(--color-bg-light);
    border-left: 3px solid var(--color-primary);
  }

  .related-program-eyebrow {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-primary);
    margin-bottom: 0.5rem;
  }

  .related-program p:last-child {
    margin-bottom: 0;
  }
</style>
