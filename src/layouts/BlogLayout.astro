---
import Layout from './Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Prose from '../components/Prose.astro';
import CtaBand from '../components/CtaBand.astro';

interface Props {
  frontmatter: {
    title: string;
    description: string;
    publishDate: Date;
    author: string;
    tags: string[];
    image?: string;
  };
  readingTime: number;
}

const { frontmatter, readingTime } = Astro.props;

const formattedDate = new Date(frontmatter.publishDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const articleMeta = {
  publishedTime: new Date(frontmatter.publishDate).toISOString(),
  author: frontmatter.author,
  tags: frontmatter.tags,
};

// Related-service CTA: matched from tags, since the schema doesn't carry a
// dedicated serviceLine field (kept the schema unchanged to avoid breaking
// the blog-writer automation's frontmatter contract).
const serviceMatchers: [RegExp, { href: string; title: string }][] = [
  [/training|mentor|onboard|fluency/i, { href: '/services/developer-training', title: 'Get your team fluent, not just faster' }],
  [/agent|workflow|autonomy|mcp|delegation/i, { href: '/services/agentic-workflows', title: 'Design the workflow, not just the prompt' }],
  [/azure|dotnet|architecture|cloud|migration|software-engineering/i, { href: '/services/custom-software', title: 'Need this built, not just explained?' }],
];
const tagString = frontmatter.tags.join(' ');
const matchedService = serviceMatchers.find(([re]) => re.test(tagString))?.[1];
---

<Layout
  title={frontmatter.title}
  description={frontmatter.description}
  image={frontmatter.image}
  article={articleMeta}
  professionalService={false}
>
  <SiteHeader />
  <main>
    <article class="section section--tight blog-post">
      <div class="container">
        <a href="/blog" class="btn btn--ghost btn--sm blog-post__back">← Back to blog</a>

        <header class="blog-post__header">
          <h1 class="blog-post__title">{frontmatter.title}</h1>
          <p class="blog-post__meta">
            <time datetime={articleMeta.publishedTime}>{formattedDate}</time>
            <span> · {frontmatter.author}</span>
            <span> · {readingTime} min read</span>
          </p>
          {frontmatter.tags.length > 0 && (
            <div class="blog-post__tags">
              {frontmatter.tags.map((tag) => (
                <a href={`/blog/tag/${tag}`} class="tag-pill">{tag}</a>
              ))}
            </div>
          )}
        </header>

        <Prose>
          <slot />
        </Prose>
      </div>
    </article>

    {matchedService && (
      <CtaBand
        title={matchedService.title}
        cta={{ href: matchedService.href, label: 'See how that works' }}
      />
    )}
  </main>
  <SiteFooter />
</Layout>

<style>
  .blog-post__back { margin-bottom: var(--space-lg); }
  .blog-post__header { max-width: var(--measure); margin-bottom: var(--space-lg); }
  .blog-post__title { font-size: var(--text-3xl); margin-bottom: 0.9rem; }
  .blog-post__meta {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-muted);
    margin-bottom: 0.9rem;
  }
  .blog-post__tags { display: flex; flex-wrap: wrap; gap: 0.4rem; }
</style>
