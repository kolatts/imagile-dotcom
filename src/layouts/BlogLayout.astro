---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  frontmatter: {
    title: string;
    description: string;
    publishDate: Date;
    author: string;
    tags: string[];
    image?: string;
  };
}

const { frontmatter } = Astro.props;

// Format date
const formattedDate = new Date(frontmatter.publishDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});

// Calculate reading time (rough estimate: 200 words per minute)
const content = await Astro.slots.render('default');
const words = content.split(/\s+/).length;
const readingTime = Math.ceil(words / 200);

// Prepare article metadata for SEO
const articleMeta = {
  publishedTime: new Date(frontmatter.publishDate).toISOString(),
  author: frontmatter.author,
  tags: frontmatter.tags
};
---

<Layout 
  title={frontmatter.title} 
  description={frontmatter.description}
  image={frontmatter.image}
  article={articleMeta}
>
  <Header />
  <main>
    <article class="blog-post">
      <a href="/blog" class="back-to-blog">
        ← Back to Blog
      </a>
      
      <header class="blog-post-header">
        <h1 class="blog-post-title">{frontmatter.title}</h1>
        
        <div class="blog-post-meta">
          <span>📅 {formattedDate}</span>
          <span>✍️ {frontmatter.author}</span>
          <span>⏱️ {readingTime} min read</span>
        </div>
        
        <p class="blog-post-description">{frontmatter.description}</p>
        
        {frontmatter.tags && frontmatter.tags.length > 0 && (
          <div class="blog-post-tags">
            {frontmatter.tags.map(tag => (
              <a href={`/blog?tag=${tag}`} class="blog-tag">{tag}</a>
            ))}
          </div>
        )}
      </header>

      <div class="blog-post-content">
        <slot />
      </div>
    </article>
  </main>
  <Footer />
</Layout>

<style>
  @import '../styles/blog.css';
</style>
