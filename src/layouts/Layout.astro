---
import { canonical } from '../lib/seo';
import { site } from '../lib/site';
import MeshBackground from '../components/ui/MeshBackground.astro';
import '@fontsource/archivo-black';
import '@fontsource-variable/work-sans';
import '@fontsource-variable/fraunces/wonk-italic.css';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  meshIntensity?: 'full' | 'quiet';
  article?: {
    publishedTime: string;
    author: string;
    tags: string[];
  };
}

const {
  title,
  description = 'Imagile is an AI consulting firm: AI training and transformation, .NET and Azure software delivery, and technology coaching for startups.',
  // TODO(Phase 5): swap for a templated default OG card; logo-splash.png is a 731KB PNG slated for deletion.
  image = '/logo-splash.png',
  noindex = false,
  meshIntensity = 'quiet',
  article
} = Astro.props;

const canonicalURL = canonical(Astro.url.pathname);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#080808" />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title="Imagile Blog" href="/rss.xml" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    {article && (
      <>
        <meta property="article:published_time" content={article.publishedTime} />
        <meta property="article:author" content={article.author} />
        {article.tags.map(tag => (
          <meta property="article:tag" content={tag} />
        ))}
      </>
    )}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site)} />

    <!-- Icons -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon.png" type="image/png" />
    <!-- TODO(Phase 5): swap to /apple-touch-icon.png once generated; logo-icon.png is slated for deletion -->
    <link rel="apple-touch-icon" href="/logo-icon.png" />

    <title>{title}</title>

    <!-- JSON-LD Structured Data -->
    {article && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        "headline": title,
        "description": description,
        "image": new URL(image, Astro.site),
        "datePublished": article.publishedTime,
        "author": {
          "@type": "Person",
          "name": article.author
        },
        "publisher": {
          "@type": "Organization",
          "name": "Imagile",
          "logo": {
            "@type": "ImageObject",
            "url": new URL('/logo-icon.png', Astro.site)
          }
        },
        "keywords": article.tags.join(', '),
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": canonicalURL
        }
      })} />
    )}
    {!article && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": site.name,
        "url": site.url,
        "logo": new URL('/logo-icon.png', Astro.site),
        "sameAs": [site.linkedInUrl]
      })} />
    )}
  </head>
  <body>
    <MeshBackground intensity={meshIntensity} />
    <a href="#main" class="skip-link">Skip to content</a>
    <slot />
  </body>
</html>

<script>
  import { initializeAppInsights, trackEvent } from '../lib/appInsights';

  // Initialize Application Insights on client side
  const connectionString = import.meta.env.PUBLIC_APPINSIGHTS_CONNECTION_STRING;
  if (connectionString) {
    initializeAppInsights(connectionString);
  }

  // Delegated click tracking for any element carrying data-track, so each new
  // CTA doesn't need its own inline listener (see CallToAction.astro history).
  document.addEventListener('click', (e) => {
    const el = (e.target as HTMLElement)?.closest<HTMLElement>('[data-track]');
    if (el) {
      trackEvent(el.dataset.track!, {
        href: el.getAttribute('href') ?? '',
        page: location.pathname
      });
    }
  });
</script>
