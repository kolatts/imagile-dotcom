---
// Imported here (JS-level), not via CSS @import in global.css: Vite only
// processes/copies the woff2 url() assets and rewrites their paths when the
// fontsource CSS is pulled in through the JS module graph. A CSS @import
// nested inside an .astro <style> block never resolves those files, and
// they 404 in the built output while still passing a local `astro dev` check.
import '@fontsource/source-serif-4/600.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-sans/700.css';
import '@fontsource/fira-code/400.css';
import '@fontsource/fira-code/500.css';
import '@fontsource/archivo/500.css';
import '@fontsource/archivo/600.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  article?: {
    publishedTime: string;
    author: string;
    tags: string[];
  };
  /** Suppress the ProfessionalService block on pages where it doesn't belong (blog posts). */
  professionalService?: boolean;
}

const {
  title,
  description = "Imagile helps companies put AI to work — training engineers to build with it, designing the agentic workflows that remove the busywork, and shipping the custom software behind it.",
  image = '/og-default.png',
  article,
  professionalService = true,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteTitle = title === 'Imagile' ? title : `${title} — Imagile`;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />

    {/* Runs before first paint so a chosen theme never flashes the other one.
        Nothing stored means no attribute, which leaves prefers-color-scheme in
        charge. data-js reveals the toggle only where it can actually work. */}
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.dataset.js = '';
        try {
          var stored = localStorage.getItem('theme');
          if (stored === 'light' || stored === 'dark') root.dataset.theme = stored;
        } catch (e) {}
      })();
    </script>

    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:site_name" content="Imagile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    {article && (
      <>
        <meta property="article:published_time" content={article.publishedTime} />
        <meta property="article:author" content={article.author} />
        {article.tags.map((tag) => (
          <meta property="article:tag" content={tag} />
        ))}
      </>
    )}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site)} />

    <!-- Icons -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Feed -->
    <link rel="alternate" type="application/rss+xml" title="Imagile Blog" href="/rss.xml" />

    <title>{siteTitle}</title>

    <!-- JSON-LD: BlogPosting for articles -->
    {article && (
      <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: title,
        description,
        image: new URL(image, Astro.site),
        datePublished: article.publishedTime,
        author: { '@type': 'Person', name: article.author, url: 'https://www.imagile.dev/about' },
        publisher: {
          '@type': 'Organization',
          name: 'Imagile',
          logo: { '@type': 'ImageObject', url: new URL('/favicon-32.png', Astro.site) },
        },
        keywords: article.tags.join(', '),
        mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL },
      })} />
    )}

    <!-- JSON-LD: ProfessionalService, site-wide except on blog posts -->
    {professionalService && (
      <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'ProfessionalService',
        name: 'Imagile',
        description: 'AI transformation consulting: developer training, agentic workflow design, and custom software development.',
        url: 'https://www.imagile.dev',
        image: new URL('/favicon-32.png', Astro.site),
        priceRange: '$$$',
        areaServed: [
          { '@type': 'City', name: 'Columbus' },
          { '@type': 'AdministrativeArea', name: 'Ohio' },
          { '@type': 'Country', name: 'Remote — anywhere' },
        ],
        address: {
          '@type': 'PostalAddress',
          addressLocality: 'Lewis Center',
          addressRegion: 'OH',
          addressCountry: 'US',
        },
        founder: {
          '@type': 'Person',
          name: 'Sunny Kolattukudy',
          url: 'https://www.imagile.dev/about',
          sameAs: [
            'https://context-overflow.dev',
            'https://github.com/kolatts',
            'https://linkedin.com/in/sunnyjk',
          ],
        },
        sameAs: [
          'https://context-overflow.dev',
          'https://github.com/kolatts',
          'https://linkedin.com/company/imagile-dev',
        ],
        makesOffer: [
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'AI Developer Training', url: 'https://www.imagile.dev/services/developer-training' } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Agentic Workflow Building', url: 'https://www.imagile.dev/services/agentic-workflows' } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Custom Software Development', url: 'https://www.imagile.dev/services/custom-software' } },
        ],
      })} />
    )}
  </head>
  <body>
    <slot />
    <script src="../scripts/motion.js"></script>
    <script src="../scripts/relative-time.js"></script>
  </body>
</html>

<script>
  import { initializeAppInsights } from '../lib/appInsights';

  const connectionString = import.meta.env.PUBLIC_APPINSIGHTS_CONNECTION_STRING;
  if (connectionString) {
    initializeAppInsights(connectionString);
  }
</script>

<style is:global>
  @import '../styles/global.css';
</style>
